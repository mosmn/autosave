---
/**
 * ACDiagnosticWizard — Interactive multi-step troubleshooting wizard
 * for car air conditioning faults and symptoms.
 */
import { diagnosticTree } from '../../data/diagnostic-tree';
import type { Language } from '../../lib/i18n';
import { WHATSAPP_NUMBER } from '../../lib/whatsapp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
---

<div
  class="w-full rounded-2xl border border-primary/20 bg-card p-5 sm:p-8 shadow-xl"
  id="ac-diagnostic-wizard"
  data-lang={lang}
  data-tree={JSON.stringify(diagnosticTree)}
  data-whatsapp={WHATSAPP_NUMBER}
>
  {/* Step Indicator Header */}
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border pb-5">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {isAr ? 'فحص تفاعلي ذكي' : 'Smart Interactive Diagnostic'}
      </span>
      <h3 class="mt-2 text-xl font-bold tracking-tight font-display text-foreground sm:text-2xl">
        {isAr ? 'تشخيص أعطال مكيف السيارة خلال دقيقة' : '1-Minute Car AC Fault Diagnostic'}
      </h3>
      <p class="mt-1 text-xs sm:text-sm text-muted-foreground">
        {isAr
          ? 'حدد العطل الذي تواجهه للإجابة على سؤالين وتحديد الخلل المحتمل وتكلفة إصلاحه فورياً'
          : 'Answer two simple questions to identify the root cause, repair cost, and DIY checks.'}
      </p>
    </div>

    {/* Progress Step Badges */}
    <div class="flex items-center gap-2 text-xs font-bold text-muted-foreground self-start">
      <span id="wizard-badge-1" class="rounded-full bg-primary text-primary-foreground px-2.5 py-1">1</span>
      <span>{isAr ? 'العطل' : 'Symptom'}</span>
      <span class="text-border">→</span>
      <span id="wizard-badge-2" class="rounded-full bg-secondary text-muted-foreground px-2.5 py-1">2</span>
      <span>{isAr ? 'الفحص' : 'Check'}</span>
      <span class="text-border">→</span>
      <span id="wizard-badge-3" class="rounded-full bg-secondary text-muted-foreground px-2.5 py-1">3</span>
      <span>{isAr ? 'التقرير' : 'Report'}</span>
    </div>
  </div>

  {/* STEP 1: Select Primary Symptom */}
  <div id="diag-step-1" class="space-y-4">
    <h4 class="text-sm font-bold text-foreground uppercase tracking-wider">
      {isAr ? 'الخطوة 1: اختر العرض الرئيسي الذي تشتكي منه في سيارتك:' : 'Step 1: Select the main issue you are experiencing:'}
    </h4>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {diagnosticTree.map((item) => (
        <button
          type="button"
          data-symptom-id={item.id}
          class="diag-symptom-btn flex flex-col items-start rounded-xl border border-border bg-background p-4 text-start transition hover:border-primary hover:bg-primary/5 active:scale-[0.98] group"
        >
          <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors mb-3">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors">
            {isAr ? item.titleAr : item.titleEn}
          </span>
          <span class="mt-1 text-xs text-muted-foreground leading-relaxed">
            {isAr ? item.shortDescAr : item.shortDescEn}
          </span>
        </button>
      ))}
    </div>
  </div>

  {/* STEP 2: Sub-Question */}
  <div id="diag-step-2" class="hidden space-y-5">
    <button
      type="button"
      id="btn-back-step-1"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline mb-2"
    >
      <svg class={`size-3.5 ${isAr ? '' : 'rotate-180'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
      <span>{isAr ? 'العودة لاختيار عطل آخر' : 'Back to symptoms'}</span>
    </button>

    <div class="rounded-xl bg-secondary/40 p-4 border border-border">
      <span class="text-xs font-bold text-primary uppercase tracking-wider block">
        {isAr ? 'الخطوة 2: فحص أدق لتحديد السبب الجذري' : 'Step 2: Narrow down the root cause'}
      </span>
      <h4 id="diag-question-text" class="text-base sm:text-lg font-bold font-display text-foreground mt-1"></h4>
    </div>

    <div id="diag-options-container" class="grid gap-3 sm:grid-cols-2">
      {/* Populated dynamically */}
    </div>
  </div>

  {/* STEP 3: Diagnostic Report Result */}
  <div id="diag-step-3" class="hidden space-y-6">
    <div class="rounded-2xl border border-primary/20 bg-gradient-to-r from-primary/10 via-background to-background p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block">
            {isAr ? 'نتيجة الفحص الفني الذكي' : 'Smart Diagnostic Result'}
          </span>
          <h4 id="res-primary-cause" class="text-xl sm:text-2xl font-bold font-display text-foreground mt-1"></h4>
        </div>
        <div class="flex items-center gap-2">
          <span id="res-confidence-badge" class="rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 px-3 py-1 text-xs font-bold">
            90% احتمال
          </span>
          <span id="res-severity-badge" class="rounded-full bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/20 px-3 py-1 text-xs font-bold uppercase">
            High
          </span>
        </div>
      </div>

      {/* Details Grid */}
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {/* Cost estimate */}
        <div class="rounded-xl border border-border bg-card p-4">
          <span class="text-xs text-muted-foreground font-semibold block">
            {isAr ? 'التكلفة التقديرية للإصلاح في السعودية:' : 'Estimated Repair Cost (SAR):'}
          </span>
          <span id="res-cost-estimate" class="text-base sm:text-lg font-bold text-primary block mt-1"></span>
        </div>

        {/* DIY check */}
        <div class="rounded-xl border border-border bg-card p-4">
          <span class="text-xs text-muted-foreground font-semibold block">
            {isAr ? 'ما يمكنك فحصه بنفسك أولاً (DIY):' : 'Quick DIY Inspection:'}
          </span>
          <span id="res-diy-check" class="text-xs sm:text-sm text-foreground block mt-1 leading-relaxed"></span>
        </div>
      </div>

      {/* Deep Explanation */}
      <div class="mt-4 rounded-xl border border-border bg-card p-4">
        <h5 class="text-xs font-bold text-foreground uppercase tracking-wider">
          {isAr ? 'التفسير الهندسي للعطل:' : 'Engineering Explanation:'}
        </h5>
        <p id="res-explanation" class="mt-1.5 text-xs sm:text-sm text-muted-foreground leading-relaxed"></p>
      </div>

      {/* Laser Test Warning */}
      <div id="res-warning-box" class="mt-4 rounded-xl bg-amber-500/10 border border-amber-500/20 p-4 text-xs text-amber-900 dark:text-amber-200">
        <strong class="font-bold">{isAr ? 'تنبيه أوتو سيف:' : 'Auto Save Warning:'}</strong> <span id="res-warning-text"></span>
      </div>

      {/* Action CTA & Buttons */}
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-border">
        <button
          type="button"
          id="btn-restart-diag"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-foreground hover:bg-secondary transition"
        >
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>{isAr ? 'فحص عطل آخر' : 'Diagnose Another Fault'}</span>
        </button>

        <a
          id="btn-whatsapp-diag-report"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 active:scale-95"
        >
          <svg class="size-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
          </svg>
          <span>{isAr ? 'إرسال التقرير لمهندس الورشة عبر واتساب' : 'Send Report to Workshop Engineer'}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initACWizard() {
    const root = document.getElementById('ac-diagnostic-wizard');
    if (!root) return;

    const lang = root.dataset.lang || 'ar';
    const isAr = lang === 'ar';
    const rawTree = root.dataset.tree;
    const whatsapp = root.dataset.whatsapp || '966537133080';
    if (!rawTree) return;

    const tree = JSON.parse(rawTree);

    const step1El = document.getElementById('diag-step-1');
    const step2El = document.getElementById('diag-step-2');
    const step3El = document.getElementById('diag-step-3');

    const badge1 = document.getElementById('wizard-badge-1');
    const badge2 = document.getElementById('wizard-badge-2');
    const badge3 = document.getElementById('wizard-badge-3');

    const questionTextEl = document.getElementById('diag-question-text');
    const optionsContainer = document.getElementById('diag-options-container');

    const backStep1Btn = document.getElementById('btn-back-step-1');
    const restartBtn = document.getElementById('btn-restart-diag');

    let currentSymptom: any = null;

    function setStep(stepNumber: number) {
      if (!step1El || !step2El || !step3El) return;

      step1El.classList.toggle('hidden', stepNumber !== 1);
      step2El.classList.toggle('hidden', stepNumber !== 2);
      step3El.classList.toggle('hidden', stepNumber !== 3);

      if (badge1 && badge2 && badge3) {
        badge1.className = stepNumber >= 1 ? 'rounded-full bg-primary text-primary-foreground px-2.5 py-1' : 'rounded-full bg-secondary text-muted-foreground px-2.5 py-1';
        badge2.className = stepNumber >= 2 ? 'rounded-full bg-primary text-primary-foreground px-2.5 py-1' : 'rounded-full bg-secondary text-muted-foreground px-2.5 py-1';
        badge3.className = stepNumber === 3 ? 'rounded-full bg-emerald-600 text-white px-2.5 py-1' : 'rounded-full bg-secondary text-muted-foreground px-2.5 py-1';
      }
    }

    // Bind Step 1 Buttons
    const symptomButtons = root.querySelectorAll('.diag-symptom-btn');
    symptomButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const symId = btn.getAttribute('data-symptom-id');
        currentSymptom = tree.find((t: any) => t.id === symId);
        if (!currentSymptom) return;

        // Populate Step 2
        if (questionTextEl && optionsContainer) {
          questionTextEl.textContent = isAr ? currentSymptom.subQuestion.questionAr : currentSymptom.subQuestion.questionEn;
          optionsContainer.innerHTML = '';

          currentSymptom.subQuestion.options.forEach((opt: any) => {
            const optBtn = document.createElement('button');
            optBtn.type = 'button';
            optBtn.className =
              'flex flex-col items-start rounded-xl border border-border bg-card p-4 text-start transition hover:border-primary hover:bg-primary/5 active:scale-[0.98] group';
            optBtn.innerHTML = `
              <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors">
                ${isAr ? opt.labelAr : opt.labelEn}
              </span>
            `;
            optBtn.onclick = () => renderResult(opt.result);
            optionsContainer.appendChild(optBtn);
          });
        }

        setStep(2);
      });
    });

    function renderResult(result: any) {
      const causeEl = document.getElementById('res-primary-cause');
      const confBadge = document.getElementById('res-confidence-badge');
      const sevBadge = document.getElementById('res-severity-badge');
      const costEl = document.getElementById('res-cost-estimate');
      const diyEl = document.getElementById('res-diy-check');
      const explEl = document.getElementById('res-explanation');
      const warnBox = document.getElementById('res-warning-box');
      const warnText = document.getElementById('res-warning-text');
      const waBtn = document.getElementById('btn-whatsapp-diag-report') as HTMLAnchorElement;

      const cause = isAr ? result.primaryCauseAr : result.primaryCauseEn;
      const cost = isAr ? result.costEstimateAr : result.costEstimateEn;
      const diy = isAr ? result.diyCheckAr : result.diyCheckEn;
      const expl = isAr ? result.explanationAr : result.explanationEn;
      const warn = isAr ? result.warningAr : result.warningEn;

      if (causeEl) causeEl.textContent = cause;
      if (confBadge) confBadge.textContent = `${result.confidencePercent}% ${isAr ? 'احتمال العطل' : 'Confidence'}`;
      if (sevBadge) sevBadge.textContent = result.severity.toUpperCase();
      if (costEl) costEl.textContent = cost;
      if (diyEl) diyEl.textContent = diy;
      if (explEl) explEl.textContent = expl;

      if (warnBox && warnText) {
        if (warn) {
          warnText.textContent = warn;
          warnBox.classList.remove('hidden');
        } else {
          warnBox.classList.add('hidden');
        }
      }

      if (waBtn) {
        const msg = isAr
          ? `السلام عليكم ورحمه الله وبركاته\nقمت بإجراء فحص مكيف السيارة عبر موقع أوتو سيف وهذه النتيجة:\n- العرض: ${currentSymptom?.titleAr}\n- التشخيص المحتمل: ${cause}\n- التكلفة التقديرية: ${cost}\nأرغب بحجز موعد فحص وتأكيد الإصلاح في ورشة الرياض.`
          : `Hello Auto Save KSA,\nI completed the online AC diagnostic test:\n- Symptom: ${currentSymptom?.titleEn}\n- Probable Fault: ${cause}\n- Cost Estimate: ${cost}\nI would like to book an inspection appointment at your Riyadh workshop.`;
        waBtn.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`;
      }

      setStep(3);
    }

    if (backStep1Btn) {
      backStep1Btn.onclick = () => setStep(1);
    }

    if (restartBtn) {
      restartBtn.onclick = () => setStep(1);
    }
  }

  document.addEventListener('DOMContentLoaded', initACWizard);
  document.addEventListener('astro:page-load', initACWizard);
  initACWizard();
</script>
