---
/**
 * FreonCalculatorWidget — Interactive client-side selector and calculator
 * for Car AC Refrigerant & Compressor Oil Capacity.
 */
import { getAllFreonSpecs, type FreonVehicleSpec } from '../../data/freon-specs';
import type { Language } from '../../lib/i18n';
import { WHATSAPP_NUMBER } from '../../lib/whatsapp';

interface Props {
  lang: Language;
  initialBrand?: string;
  initialModel?: string;
}

const { lang, initialBrand, initialModel } = Astro.props;
const specs = getAllFreonSpecs();

const isAr = lang === 'ar';
---

<div
  class="w-full rounded-2xl border border-primary/20 bg-card p-5 sm:p-8 shadow-xl"
  id="freon-calculator-widget"
  data-lang={lang}
  data-specs={JSON.stringify(specs)}
  data-initial-brand={initialBrand ?? ''}
  data-initial-model={initialModel ?? ''}
  data-whatsapp={WHATSAPP_NUMBER}
>
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border pb-5">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m9-9H3" />
        </svg>
        {isAr ? 'حاسبة فورية مجانية' : 'Instant Free Calculator'}
      </span>
      <h3 class="mt-2 text-xl font-bold tracking-tight font-display text-foreground sm:text-2xl">
        {isAr ? 'فاحص كمية ونوع فريون وزيت سيارتك' : 'Check Freon Capacity & Oil Specs'}
      </h3>
      <p class="mt-1 text-xs sm:text-sm text-muted-foreground">
        {isAr
          ? 'اختر الشركة المصنعة والموديل لمعرفة كمية الفريون بالجرام ونوع الزيت الموصى به بدقة'
          : 'Select your vehicle make and model for exact refrigerant grams and recommended compressor oil'}
      </p>
    </div>
    <div class="flex items-center gap-2 text-xs font-medium text-muted-foreground bg-secondary/50 rounded-lg px-3 py-2 self-start">
      <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
      {isAr ? 'محدث لمعايير صيف 2026' : 'Calibrated for Summer 2026'}
    </div>
  </div>

  {/* Selectors Grid */}
  <div class="grid gap-4 sm:grid-cols-3">
    {/* 1. Brand Selector */}
    <div>
      <label for="calc-brand" class="block text-xs font-bold text-foreground mb-1.5 uppercase tracking-wider">
        {isAr ? '1. ماركة السيارة' : '1. Make / Brand'}
      </label>
      <div class="relative">
        <select
          id="calc-brand"
          class="w-full appearance-none rounded-xl border border-input bg-background px-4 py-3 text-sm font-medium text-foreground transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        >
          <option value="">{isAr ? '-- اختر الشركة المصنعة --' : '-- Select Vehicle Make --'}</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-muted-foreground">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    {/* 2. Model Selector */}
    <div>
      <label for="calc-model" class="block text-xs font-bold text-foreground mb-1.5 uppercase tracking-wider">
        {isAr ? '2. الموديل' : '2. Car Model'}
      </label>
      <div class="relative">
        <select
          id="calc-model"
          disabled
          class="w-full appearance-none rounded-xl border border-input bg-background px-4 py-3 text-sm font-medium text-foreground transition disabled:opacity-50 disabled:cursor-not-allowed focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        >
          <option value="">{isAr ? '-- اختر الموديل --' : '-- Select Model --'}</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-muted-foreground">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    {/* 3. Year/Generation Selector */}
    <div>
      <label for="calc-year" class="block text-xs font-bold text-foreground mb-1.5 uppercase tracking-wider">
        {isAr ? '3. سنة الصنع / الجيل' : '3. Year / Generation'}
      </label>
      <div class="relative">
        <select
          id="calc-year"
          disabled
          class="w-full appearance-none rounded-xl border border-input bg-background px-4 py-3 text-sm font-medium text-foreground transition disabled:opacity-50 disabled:cursor-not-allowed focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        >
          <option value="">{isAr ? '-- سنة الصنع --' : '-- Year Range --'}</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-muted-foreground">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  {/* Results Container (Hidden until selected) */}
  <div id="calc-results" class="hidden mt-6 pt-6 border-t border-border">
    {/* Highlight Banner */}
    <div class="rounded-xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent p-4 sm:p-6 border border-primary/20">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span id="res-badge-brand" class="text-xs font-bold uppercase tracking-wider text-primary"></span>
          <h4 id="res-title" class="text-xl sm:text-2xl font-bold font-display text-foreground mt-0.5"></h4>
        </div>
        <div class="flex items-center gap-2">
          <span id="res-gas-type-pill" class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold text-primary-foreground bg-primary shadow-sm">
            R134a
          </span>
          <span id="res-category-pill" class="rounded-full bg-secondary px-3 py-1 text-xs font-medium text-muted-foreground">
          </span>
        </div>
      </div>

      {/* Primary KPI Metrics */}
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        {/* Metric 1: Freon Weight */}
        <div class="rounded-xl border border-border bg-card p-3 sm:p-4 text-center">
          <span class="text-xs text-muted-foreground font-medium block">
            {isAr ? 'كمية الفريون (مكيف واحد)' : 'Refrigerant (Single AC)'}
          </span>
          <div class="mt-1 flex items-baseline justify-center gap-1">
            <span id="res-freon-grams" class="text-2xl sm:text-3xl font-extrabold text-primary font-display">0</span>
            <span class="text-xs font-bold text-muted-foreground">{isAr ? 'جرام' : 'g'}</span>
          </div>
          <span id="res-freon-tolerance" class="text-[11px] text-muted-foreground/80 block mt-0.5">± 30g</span>
        </div>

        {/* Metric 2: Dual AC (if applicable) */}
        <div class="rounded-xl border border-border bg-card p-3 sm:p-4 text-center" id="res-dual-ac-card">
          <span class="text-xs text-muted-foreground font-medium block">
            {isAr ? 'كمية الفريون (مكيفين)' : 'Refrigerant (Dual AC)'}
          </span>
          <div class="mt-1 flex items-baseline justify-center gap-1">
            <span id="res-dual-freon-grams" class="text-2xl sm:text-3xl font-extrabold text-foreground font-display">-</span>
            <span class="text-xs font-bold text-muted-foreground">{isAr ? 'جرام' : 'g'}</span>
          </div>
          <span class="text-[11px] text-muted-foreground/80 block mt-0.5">{isAr ? 'للصف الخلفي' : 'Rear cabin'}</span>
        </div>

        {/* Metric 3: Oil Type & Viscosity */}
        <div class="rounded-xl border border-border bg-card p-3 sm:p-4 text-center">
          <span class="text-xs text-muted-foreground font-medium block">
            {isAr ? 'نوع زيت الكمبروسر' : 'Compressor Oil Spec'}
          </span>
          <span id="res-oil-type" class="mt-1 text-sm sm:text-base font-bold text-foreground block truncate">PAG 46</span>
          <span id="res-oil-capacity" class="text-[11px] text-muted-foreground/80 block mt-0.5">120 ml</span>
        </div>

        {/* Metric 4: Summer Operating Pressure */}
        <div class="rounded-xl border border-border bg-card p-3 sm:p-4 text-center">
          <span class="text-xs text-muted-foreground font-medium block">
            {isAr ? 'ضغط الصيف (حرارة 45°م)' : 'Summer PSI @ 45°C'}
          </span>
          <span id="res-low-pressure" class="mt-1 text-sm sm:text-base font-bold text-foreground block">32 - 40 PSI</span>
          <span id="res-high-pressure" class="text-[11px] text-muted-foreground/80 block mt-0.5">High: 220-270 PSI</span>
        </div>
      </div>

      {/* Model Technical Note */}
      <div id="res-note-box" class="mt-4 rounded-lg bg-amber-500/10 border border-amber-500/20 p-3 text-xs text-amber-900 dark:text-amber-200 hidden">
        <span class="font-bold">{isAr ? 'ملاحظة فنية:' : 'Technical Note:'}</span> <span id="res-note-text"></span>
      </div>
    </div>

    {/* Actions Bar */}
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <button
        type="button"
        id="btn-copy-specs"
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-foreground transition hover:bg-secondary active:scale-95"
      >
        <svg class="size-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="btn-copy-text">{isAr ? 'نسخ بيانات الشحن' : 'Copy Specifications'}</span>
      </button>

      <div class="flex flex-wrap items-center gap-2">
        <a
          id="link-model-page"
          href="#"
          class="inline-flex items-center gap-1 rounded-xl border border-primary/30 px-3 py-2 text-xs font-semibold text-primary transition hover:bg-primary/5"
        >
          <span>{isAr ? 'دليل أعطال الموديل كاملاً' : 'Full Model AC Guide'}</span>
          <svg class={`size-3.5 ${isAr ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          id="link-whatsapp-book"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 active:scale-95"
        >
          <svg class="size-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
          </svg>
          <span>{isAr ? 'حجز تعبئة بميزان إلكتروني في الرياض' : 'Book Scale Recharge in Riyadh'}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Client-side interactive logic
  function initFreonCalculator() {
    const root = document.getElementById('freon-calculator-widget');
    if (!root) return;

    const lang = root.dataset.lang || 'ar';
    const isAr = lang === 'ar';
    const rawSpecs = root.dataset.specs;
    if (!rawSpecs) return;

    const specs = JSON.parse(rawSpecs);
    const initialBrand = root.dataset.initialBrand;
    const initialModel = root.dataset.initialModel;
    const whatsappNumber = root.dataset.whatsapp || '966537133080';

    const brandSelect = document.getElementById('calc-brand') as HTMLSelectElement;
    const modelSelect = document.getElementById('calc-model') as HTMLSelectElement;
    const yearSelect = document.getElementById('calc-year') as HTMLSelectElement;
    const resultsContainer = document.getElementById('calc-results');

    if (!brandSelect || !modelSelect || !yearSelect || !resultsContainer) return;

    // Populate Brands (Unique)
    const brandMap = new Map();
    specs.forEach((s: any) => {
      if (!brandMap.has(s.brandSlug)) {
        brandMap.set(s.brandSlug, {
          name: isAr ? s.brandNameAr : s.brandNameEn,
          slug: s.brandSlug,
        });
      }
    });

    brandMap.forEach((brand) => {
      const opt = document.createElement('option');
      opt.value = brand.slug;
      opt.textContent = brand.name;
      brandSelect.appendChild(opt);
    });

    function updateModels(selectedBrandSlug: string) {
      modelSelect.innerHTML = `<option value="">${isAr ? '-- اختر الموديل --' : '-- Select Model --'}</option>`;
      yearSelect.innerHTML = `<option value="">${isAr ? '-- سنة الصنع --' : '-- Year Range --'}</option>`;
      yearSelect.disabled = true;
      resultsContainer.classList.add('hidden');

      if (!selectedBrandSlug) {
        modelSelect.disabled = true;
        return;
      }

      const matchingModels = specs.filter((s: any) => s.brandSlug === selectedBrandSlug);
      matchingModels.forEach((s: any) => {
        const opt = document.createElement('option');
        opt.value = s.modelSlug;
        opt.textContent = isAr ? s.modelNameAr : s.modelNameEn;
        modelSelect.appendChild(opt);
      });

      modelSelect.disabled = false;
    }

    function updateYears(brandSlug: string, modelSlug: string) {
      yearSelect.innerHTML = `<option value="">${isAr ? '-- سنة الصنع --' : '-- Year Range --'}</option>`;
      resultsContainer.classList.add('hidden');

      if (!brandSlug || !modelSlug) {
        yearSelect.disabled = true;
        return;
      }

      const found = specs.find((s: any) => s.brandSlug === brandSlug && s.modelSlug === modelSlug);
      if (!found) {
        yearSelect.disabled = true;
        return;
      }

      found.generations.forEach((gen: any, idx: number) => {
        const opt = document.createElement('option');
        opt.value = idx.toString();
        opt.textContent = gen.years;
        yearSelect.appendChild(opt);
      });

      yearSelect.disabled = false;
      // Auto select first generation
      if (found.generations.length > 0) {
        yearSelect.selectedIndex = 1;
        renderResults(found, found.generations[0]);
      }
    }

    function renderResults(spec: any, gen: any) {
      const brandName = isAr ? spec.brandNameAr : spec.brandNameEn;
      const modelName = isAr ? spec.modelNameAr : spec.modelNameEn;

      const resBadgeBrand = document.getElementById('res-badge-brand');
      const resTitle = document.getElementById('res-title');
      const resGasTypePill = document.getElementById('res-gas-type-pill');
      const resCategoryPill = document.getElementById('res-category-pill');
      const resFreonGrams = document.getElementById('res-freon-grams');
      const resFreonTolerance = document.getElementById('res-freon-tolerance');
      const resDualCard = document.getElementById('res-dual-ac-card');
      const resDualFreonGrams = document.getElementById('res-dual-freon-grams');
      const resOilType = document.getElementById('res-oil-type');
      const resOilCapacity = document.getElementById('res-oil-capacity');
      const resLowPressure = document.getElementById('res-low-pressure');
      const resHighPressure = document.getElementById('res-high-pressure');
      const resNoteBox = document.getElementById('res-note-box');
      const resNoteText = document.getElementById('res-note-text');
      const linkModelPage = document.getElementById('link-model-page') as HTMLAnchorElement;
      const linkWhatsappBook = document.getElementById('link-whatsapp-book') as HTMLAnchorElement;

      if (resBadgeBrand) resBadgeBrand.textContent = brandName;
      if (resTitle) resTitle.textContent = `${modelName} (${gen.years})`;
      if (resGasTypePill) {
        resGasTypePill.textContent = gen.refrigerantType;
        if (gen.refrigerantType === 'R1234yf') {
          resGasTypePill.className = 'inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold text-emerald-950 bg-emerald-400 shadow-sm';
        } else {
          resGasTypePill.className = 'inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold text-primary-foreground bg-primary shadow-sm';
        }
      }

      if (resCategoryPill) {
        resCategoryPill.textContent = spec.category.toUpperCase();
      }

      if (resFreonGrams) resFreonGrams.textContent = gen.capacityGrams.toString();
      if (resFreonTolerance) resFreonTolerance.textContent = `± ${gen.toleranceGrams}g`;

      if (resDualCard && resDualFreonGrams) {
        if (gen.capacityGramsDualAc) {
          resDualFreonGrams.textContent = gen.capacityGramsDualAc.toString();
          resDualCard.classList.remove('opacity-40');
        } else {
          resDualFreonGrams.textContent = isAr ? 'غير متاح' : 'N/A';
          resDualCard.classList.add('opacity-40');
        }
      }

      if (resOilType) resOilType.textContent = gen.oilType;
      if (resOilCapacity) resOilCapacity.textContent = `${gen.oilCapacityMl} ml`;
      if (resLowPressure) resLowPressure.textContent = gen.lowPressurePsiSummer;
      if (resHighPressure) resHighPressure.textContent = `High: ${gen.highPressurePsiSummer}`;

      const note = isAr ? gen.notesAr : gen.notesEn;
      if (resNoteBox && resNoteText) {
        if (note) {
          resNoteText.textContent = note;
          resNoteBox.classList.remove('hidden');
        } else {
          resNoteBox.classList.add('hidden');
        }
      }

      if (linkModelPage) {
        const pathPrefix = isAr ? '' : '/en';
        linkModelPage.href = `${pathPrefix}/tools/freon-capacity/${spec.brandSlug}/${spec.modelSlug}/`;
      }

      if (linkWhatsappBook) {
        const msg = isAr
          ? `السلام عليكم ورحمه الله وبركاته\nأرغب في حجز موعد فحص وتعبئة فريون بميزان إلكتروني لسيارتي ${brandName} ${modelName} (${gen.years}) في ورشة أوتو سيف بالرياض.`
          : `Hello Auto Save KSA, I would like to book a precision scale freon recharge and inspection for my ${brandName} ${modelName} (${gen.years}) in Riyadh.`;
        linkWhatsappBook.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
      }

      resultsContainer.classList.remove('hidden');

      // Setup Copy specs button
      const copyBtn = document.getElementById('btn-copy-specs');
      const copyText = document.getElementById('btn-copy-text');
      if (copyBtn && copyText) {
        copyBtn.onclick = () => {
          const textToCopy = `${brandName} ${modelName} (${gen.years})\n${isAr ? 'نوع الفريون' : 'Refrigerant'}: ${gen.refrigerantType}\n${isAr ? 'كمية الفريون' : 'Capacity'}: ${gen.capacityGrams}g (±${gen.toleranceGrams}g)${gen.capacityGramsDualAc ? ` [Dual AC: ${gen.capacityGramsDualAc}g]` : ''}\n${isAr ? 'زيت الكمبروسر' : 'Oil'}: ${gen.oilType} (${gen.oilCapacityMl} ml)\n${isAr ? 'المصدر: أوتو سيف الرياض' : 'Source: Auto Save KSA'} https://autosaveks.com`;
          navigator.clipboard.writeText(textToCopy).then(() => {
            copyText.textContent = isAr ? 'تم النسخ بنجاح!' : 'Copied to Clipboard!';
            setTimeout(() => {
              copyText.textContent = isAr ? 'نسخ بيانات الشحن' : 'Copy Specifications';
            }, 2500);
          });
        };
      }
    }

    brandSelect.addEventListener('change', (e) => {
      const b = (e.target as HTMLSelectElement).value;
      updateModels(b);
    });

    modelSelect.addEventListener('change', (e) => {
      const m = (e.target as HTMLSelectElement).value;
      const b = brandSelect.value;
      updateYears(b, m);
    });

    yearSelect.addEventListener('change', (e) => {
      const idx = parseInt((e.target as HTMLSelectElement).value, 10);
      const b = brandSelect.value;
      const m = modelSelect.value;
      const found = specs.find((s: any) => s.brandSlug === b && s.modelSlug === m);
      if (found && !isNaN(idx) && found.generations[idx]) {
        renderResults(found, found.generations[idx]);
      }
    });

    // Auto-select initial brand / model if provided
    if (initialBrand) {
      brandSelect.value = initialBrand;
      updateModels(initialBrand);
      if (initialModel) {
        modelSelect.value = initialModel;
        updateYears(initialBrand, initialModel);
      }
    }
  }

  // Support both direct load and Astro view transitions / client navigation
  document.addEventListener('DOMContentLoaded', initFreonCalculator);
  document.addEventListener('astro:page-load', initFreonCalculator);
  initFreonCalculator();
</script>
