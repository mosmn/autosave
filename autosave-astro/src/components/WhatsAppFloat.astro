
---
import type { Language } from '../lib/i18n';
import { getContentByLanguage } from '../lib/content';
import { ARABIC_GREETING, prependArabicGreeting, getWhatsAppComposeUrl } from '../lib/whatsapp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const content = getContentByLanguage(lang);
const isAr = lang === 'ar';

const chatAriaLabel = isAr ? 'افتح الدردشة على واتساب' : 'Open chat on WhatsApp';

// Pre-compute the Arabic WhatsApp URL with the greeting baked in
const arabicWhatsAppUrl = getWhatsAppComposeUrl(prependArabicGreeting());
---

<button
  type="button"
  id="whatsapp-float-btn"
  data-whatsapp-fallback="https://wa.me/966537133080"
  data-whatsapp-ar={isAr ? arabicWhatsAppUrl : undefined}
  aria-label={chatAriaLabel}
  class="whatsapp-pulse whatsapp-entrance fixed bottom-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl shadow-[#25D366]/25 transition-transform hover:scale-110"
  style={isAr ? 'inset-inline-start: 1.5rem;' : 'inset-inline-start: auto; inset-inline-end: 1.5rem;'}
>
  <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
  </svg>
</button>

<script is:inline define:vars={{ isAr, arabicWhatsAppUrl }}>
  (function() {
    var STORAGE_INTENT_KEY = 'autosave_chat_intent';
    var STORAGE_HISTORY_KEY = 'autosave_chat_history';

    function saveChatIntent(message) {
      try {
        var data = {
          intent: 'floating_button',
          message: message || '',
          pageUrl: window.location.href,
          pageTitle: document.title,
          timestamp: new Date().toISOString()
        };
        localStorage.setItem(STORAGE_INTENT_KEY, JSON.stringify(data));
        var history = JSON.parse(localStorage.getItem(STORAGE_HISTORY_KEY) || '[]');
        history.push(data);
        if (history.length > 50) history = history.slice(-50);
        localStorage.setItem(STORAGE_HISTORY_KEY, JSON.stringify(history));
      } catch (e) {}
    }

    document.addEventListener('click', function(e) {
      var el = e.target;
      while (el && el !== document) {
        if (el.id === 'whatsapp-float-btn') {
          e.preventDefault();
          e.stopPropagation();
                    if (isAr) {
            // Arabic page → redirect to WhatsApp with the greeting as the message
            saveChatIntent('السلام عليكم ورحمه الله وبركاته');
            window.open(arabicWhatsAppUrl, '_blank', 'noopener,noreferrer');
          } else {
            // English page → fallback to WhatsApp
            window.open(el.getAttribute('data-whatsapp-fallback') || 'https://wa.me/966537133080', '_blank', 'noopener,noreferrer');
          }
          return;
        }
        el = el.parentElement;
      }
    });
  })();
</script>
