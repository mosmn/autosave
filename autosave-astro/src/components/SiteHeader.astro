---
import type { Language } from '../lib/i18n';
import { getContentByLanguage } from '../lib/content';
import { getLocalizedPath, getAlternateLang } from '../lib/i18n';
import { getCityBySlug } from '../data/cities';
import ComingSoonLink from './ComingSoonLink.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const content = getContentByLanguage(lang);
const altLang = getAlternateLang(lang);
const currentPath = Astro.url.pathname;

// Strip language prefix to get the base path for the toggle link
function getBasePath(path: string): string {
  if (path.startsWith('/en/')) return path.slice(3);
  if (path === '/en') return '/';
  return path;
}

const basePath = getBasePath(currentPath);
const toggleHref = getLocalizedPath(basePath, altLang);
const toggleLabel = altLang === 'ar' ? 'العربية' : 'English';

function resolveHeaderHref(href: string): string {
  return getLocalizedPath(href, lang);
}

const riyadh = getCityBySlug('riyadh');
const riyadhNeighborhoods = riyadh?.neighborhoods?.slice(0, 6) ?? [];

// Core featured services with curated micro-descriptions
const featuredServices = [
  {
    slug: 'ac-recharge',
    nameAr: 'تعبئة فريون مكيف السيارة',
    nameEn: 'Car AC Freon Recharge',
    descAr: 'تعبئة رقمية دقيقة لغاز R134a و R1234yf مع اختبار الضغط',
    descEn: 'Digital precision R134a & R1234yf recharge with pressure test',
    icon: 'recharge',
  },
  {
    slug: 'compressor-replacement',
    nameAr: 'تغيير كمبروسر المكيف',
    nameEn: 'Compressor Replacement',
    descAr: 'استبدال وضمان كمبروسرات أصلية لجميع فئات وموديلات السيارات',
    descEn: 'OEM compressor replacement and warranty for all makes',
    icon: 'compressor',
  },
  {
    slug: 'leak-detection',
    nameAr: 'كشف تهريب الفريون',
    nameEn: 'AC Leak Detection',
    descAr: 'فحص إلكتروني دقيق بالنيتروجين وأشعة UV لتحديد موقع التسريب',
    descEn: 'Pinpoint electronic nitrogen and UV dye leak diagnostic',
    icon: 'leak',
  },
  {
    slug: 'ac-cleaning',
    nameAr: 'تنظيف وتعقيم ثلاجة المكيف',
    nameEn: 'Evaporator Cleaning',
    descAr: 'إزالة الروائح الكريهة وتعقيم مجاري الهواء لبيئة صحية',
    descEn: 'Odor removal and deep antibacterial air duct sanitization',
    icon: 'clean',
  },
  {
    slug: 'condenser-repair',
    nameAr: 'إصلاح وتبديل رديتر المكيف',
    nameEn: 'Condenser Repair & Swap',
    descAr: 'استعادة كفاءة التبريد القصوى ومقاومة حرارة الصيف العالية',
    descEn: 'Restoring cooling efficiency against extreme summer heat',
    icon: 'condenser',
  },
  {
    slug: 'full-ac-overhaul',
    nameAr: 'توضيب وتجديد دورة المكيف',
    nameEn: 'Complete System Overhaul',
    descAr: 'تجديد شامل لشبكة التبريد وغسيل الدورة وتغيير البلف والمجفف',
    descEn: 'Full cooling system flush, expansion valve & receiver refresh',
    icon: 'overhaul',
  },
];

// Top 12 popular car makes in Saudi Arabia
const featuredBrands = [
  { slug: 'toyota', nameAr: 'تويوتا', nameEn: 'Toyota' },
  { slug: 'hyundai', nameAr: 'هيونداي', nameEn: 'Hyundai' },
  { slug: 'nissan', nameAr: 'نيسان', nameEn: 'Nissan' },
  { slug: 'ford', nameAr: 'فورد', nameEn: 'Ford' },
  { slug: 'lexus', nameAr: 'لكزس', nameEn: 'Lexus' },
  { slug: 'chevrolet', nameAr: 'شيفروليه', nameEn: 'Chevrolet' },
  { slug: 'gmc', nameAr: 'جمس', nameEn: 'GMC' },
  { slug: 'kia', nameAr: 'كيا', nameEn: 'Kia' },
  { slug: 'mercedes', nameAr: 'مرسيدس', nameEn: 'Mercedes-Benz' },
  { slug: 'bmw', nameAr: 'بي إم دبليو', nameEn: 'BMW' },
  { slug: 'changan', nameAr: 'شانجان', nameEn: 'Changan' },
  { slug: 'geely', nameAr: 'جيلي', nameEn: 'Geely' },
];

const isCurrentRoute = (href: string) => {
  const target = resolveHeaderHref(href);
  if (target === '/' || target === '/en') {
    return currentPath === target;
  }
  return currentPath.startsWith(target);
};
---

<header
  class="sticky top-0 z-50 w-full border-b border-border/80 bg-background/90 backdrop-blur-xl transition-all duration-200"
  data-site-header
>
  <div class="container mx-auto flex h-20 items-center justify-between px-4 lg:px-6">
    {/* Brand Logo */}
    <a
      href={getLocalizedPath('/', lang)}
      class="group flex items-center gap-2.5 transition-opacity hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 rounded-lg"
      aria-label={lang === 'ar' ? 'اوتو سيف الرئيسية' : 'AUTO SAVE Home'}
    >
      {lang === 'ar' ? (
        <img src="/logo-ar.svg?v=3" alt="اوتو سيف" width="138" height="38" class="h-9 w-auto drop-shadow-sm" />
      ) : (
        <img src="/logo.svg" alt="AUTO SAVE" width="138" height="38" class="h-9 w-auto drop-shadow-sm" />
      )}
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-[14px]" aria-label="Main Navigation">
      {/* Services Dropdown */}
      <div class="relative group/menu" data-menu-key="services">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-medium text-muted-foreground transition-all hover:bg-secondary/70 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          aria-label={content.header.servicesMenu.trigger}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="desktop-menu-services"
          data-menu-trigger="services"
        >
          <span>{content.header.servicesMenu.trigger}</span>
          <svg
            class="size-4 text-muted-foreground/70 transition-transform duration-200 group-hover/menu:text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
            data-menu-chevron="services"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div
          id="desktop-menu-services"
          data-menu-panel="services"
          class="pointer-events-none invisible absolute start-0 top-full z-50 mt-2 w-[min(94vw,52rem)] rounded-2xl border border-border/80 bg-card/98 p-6 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-200 transform translate-y-1"
        >
          <div class="grid gap-6 md:grid-cols-[1.6fr_1fr]">
            {/* Core Services Column */}
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-border/60">
                <span class="text-xs font-semibold uppercase tracking-wider text-primary">
                  {content.header.servicesMenu.featuredLabel}
                </span>
                <a
                  href={resolveHeaderHref('/pricing')}
                  class="text-xs font-medium text-muted-foreground hover:text-primary transition-colors inline-flex items-center gap-1"
                >
                  <span>{content.header.servicesMenu.pricingLinkLabel}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {featuredServices.map((service) => (
                  <a
                    href={getLocalizedPath(`/services/${service.slug}`, lang)}
                    class="group flex flex-col p-2.5 rounded-xl border border-transparent hover:border-primary/20 hover:bg-secondary/40 transition-all"
                  >
                    <div class="flex items-center gap-2">
                      <span class="size-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
                        {service.icon === 'recharge' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m9-9H3m15.364-6.364-12.728 12.728m12.728 0L5.636 5.636" />
                          </svg>
                        )}
                        {service.icon === 'compressor' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                          </svg>
                        )}
                        {service.icon === 'leak' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                          </svg>
                        )}
                        {service.icon === 'clean' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                          </svg>
                        )}
                        {service.icon === 'condenser' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h12A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6ZM7.5 7.5v9M12 7.5v9M16.5 7.5v9" />
                          </svg>
                        )}
                        {service.icon === 'overhaul' && (
                          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.32l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.32 4.486c.047.58.024 1.193-.14 1.743" />
                          </svg>
                        )}
                      </span>
                      <span class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">
                        {lang === 'ar' ? service.nameAr : service.nameEn}
                      </span>
                    </div>
                    <p class="mt-1 text-[11px] text-muted-foreground line-clamp-2 leading-relaxed">
                      {lang === 'ar' ? service.descAr : service.descEn}
                    </p>
                  </a>
                ))}
              </div>
            </div>

            {/* Riyadh Areas & Quick Links Column */}
            <aside class="rounded-xl border border-border/80 bg-secondary/35 p-4 flex flex-col justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-primary">
                  {content.header.servicesMenu.areasLabel}
                </span>
                <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                  {content.header.servicesMenu.neighborhoodsHintLabel}
                </p>

                {riyadhNeighborhoods.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {riyadhNeighborhoods.map((n) => (
                      <a
                        href={getLocalizedPath(`/services/riyadh/${n.slug}`, lang)}
                        class="rounded-md border border-border/80 bg-card/80 px-2 py-1 text-[11px] font-medium text-foreground hover:border-primary/50 hover:text-primary hover:bg-card transition-all"
                      >
                        {lang === 'ar' ? n.nameAr : n.nameEn}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              <div class="mt-4 pt-3 border-t border-border/60 space-y-2">
                <a
                  href={getLocalizedPath('/services/riyadh', lang)}
                  class="flex items-center justify-between text-xs font-semibold text-foreground hover:text-primary transition-colors"
                >
                  <span>{content.header.servicesMenu.riyadhLinkLabel}</span>
                  <span aria-hidden="true">→</span>
                </a>
                <ComingSoonLink
                  href={getLocalizedPath('/contact', lang)}
                  lang={lang}
                  class="flex items-center justify-between text-xs font-semibold text-primary hover:text-primary/80 transition-colors"
                >
                  <span>{content.header.servicesMenu.contactLinkLabel}</span>
                  <span aria-hidden="true">→</span>
                </ComingSoonLink>
              </div>
            </aside>
          </div>
        </div>
      </div>

      {/* Cars Dropdown */}
      <div class="relative group/menu" data-menu-key="cars">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-medium text-muted-foreground transition-all hover:bg-secondary/70 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          aria-label={content.header.carsMenu.trigger}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="desktop-menu-cars"
          data-menu-trigger="cars"
        >
          <span>{content.header.carsMenu.trigger}</span>
          <svg
            class="size-4 text-muted-foreground/70 transition-transform duration-200 group-hover/menu:text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
            data-menu-chevron="cars"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div
          id="desktop-menu-cars"
          data-menu-panel="cars"
          class="pointer-events-none invisible absolute start-0 top-full z-50 mt-2 w-[min(94vw,44rem)] rounded-2xl border border-border/80 bg-card/98 p-6 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-200 transform translate-y-1"
        >
          <div class="flex items-center justify-between pb-3 border-b border-border/60">
            <div>
              <h3 class="text-sm font-semibold text-foreground font-display">
                {content.header.carsMenu.title}
              </h3>
              <p class="text-xs text-muted-foreground mt-0.5">
                {content.header.carsMenu.description}
              </p>
            </div>
            <a
              href={resolveHeaderHref('/tools/freon-capacity')}
              class="text-xs font-medium text-primary hover:underline shrink-0 ms-3"
            >
              {lang === 'ar' ? 'جدول الفريون' : 'Freon Specs'} →
            </a>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2">
            {featuredBrands.map((brand) => (
              <a
                href={getLocalizedPath(`/car-ac/${brand.slug}`, lang)}
                class="group flex items-center justify-between p-2.5 rounded-xl border border-border/60 bg-background/50 hover:border-primary/40 hover:bg-secondary/40 transition-all"
              >
                <div class="flex items-center gap-2">
                  <span class="size-6 rounded-md bg-secondary flex items-center justify-center text-[10px] font-bold text-muted-foreground group-hover:bg-primary group-hover:text-white transition-colors uppercase">
                    {brand.slug.slice(0, 2)}
                  </span>
                  <span class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">
                    {lang === 'ar' ? brand.nameAr : brand.nameEn}
                  </span>
                </div>
                <svg class="size-3.5 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            ))}
          </div>

          <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
            <span>{content.header.carsMenu.quickLinksLabel}</span>
            <div class="flex items-center gap-4">
              <a href={resolveHeaderHref('/blog')} class="hover:text-primary transition-colors">
                {content.header.carsMenu.blogLinkLabel}
              </a>
              <a href={resolveHeaderHref('/tools')} class="font-medium text-primary hover:underline">
                {content.header.carsMenu.viewAllBrandsLabel} →
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Tools Dropdown */}
      <div class="relative group/menu" data-menu-key="tools">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-medium text-muted-foreground transition-all hover:bg-secondary/70 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          aria-label={content.header.toolsMenu.trigger}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="desktop-menu-tools"
          data-menu-trigger="tools"
        >
          <span>{content.header.toolsMenu.trigger}</span>
          <span class="rounded-full bg-primary/15 px-1.5 py-0.2 text-[10px] font-bold text-primary border border-primary/25">
            {content.header.toolsMenu.badge}
          </span>
          <svg
            class="size-4 text-muted-foreground/70 transition-transform duration-200 group-hover/menu:text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
            data-menu-chevron="tools"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div
          id="desktop-menu-tools"
          data-menu-panel="tools"
          class="pointer-events-none invisible absolute start-0 lg:start-auto lg:ltr:-start-20 lg:rtl:-end-20 top-full z-50 mt-2 w-[min(94vw,46rem)] rounded-2xl border border-border/80 bg-card/98 p-6 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-200 transform translate-y-1"
        >
          <div class="flex items-center justify-between pb-3 border-b border-border/60">
            <div>
              <h3 class="text-sm font-semibold text-foreground font-display">
                {content.header.toolsMenu.title}
              </h3>
              <p class="text-xs text-muted-foreground mt-0.5">
                {content.header.toolsMenu.description}
              </p>
            </div>
            <a
              href={resolveHeaderHref('/tools')}
              class="text-xs font-semibold text-primary hover:underline shrink-0 ms-3"
            >
              {content.header.toolsMenu.viewAllToolsLabel} →
            </a>
          </div>

          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {content.header.toolsMenu.items.map((tool) => (
              <a
                href={resolveHeaderHref(tool.href)}
                class="group flex flex-col p-3 rounded-xl border border-border/60 bg-background/50 hover:border-primary/40 hover:bg-secondary/40 transition-all"
              >
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">
                    {tool.name}
                  </span>
                  <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-medium text-primary border border-primary/20">
                    {tool.badge}
                  </span>
                </div>
                <p class="mt-1 text-[11px] text-muted-foreground leading-relaxed">
                  {tool.desc}
                </p>
              </a>
            ))}
          </div>

          <div class="mt-4 rounded-xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent p-3 border border-primary/20 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="size-8 rounded-lg bg-primary text-white flex items-center justify-center shrink-0 shadow-sm">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold text-foreground">
                  {content.header.toolsMenu.toolsHubLinkLabel}
                </p>
                <p class="text-[11px] text-muted-foreground">
