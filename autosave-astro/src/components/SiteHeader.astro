<script>
  (() => {
    const initHeaderMenus = () => {
      const header = document.querySelector('[data-site-header]');
      if (!header || header.dataset.menuBound === 'true') {
        return;
      }
      header.dataset.menuBound = 'true';

      const mobileBtn = header.querySelector('#mobile-menu-btn');
      const mobileMenu = header.querySelector('#mobile-menu');
      const mobileIconOpen = header.querySelector('.mobile-icon-open');
      const mobileIconClose = header.querySelector('.mobile-icon-close');
      const mobileLinks = header.querySelectorAll('#mobile-menu a');
      const mobileSubmenus = Array.from(header.querySelectorAll('#mobile-menu details[data-mobile-submenu]'));

      // Scroll detection for sticky shadow
      const handleScroll = () => {
        if (window.scrollY > 12) {
          header.classList.add('shadow-md', 'shadow-black/5', 'border-primary/25', 'bg-background/95');
        } else {
          header.classList.remove('shadow-md', 'shadow-black/5', 'border-primary/25', 'bg-background/95');
        }
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      // Mobile Menu Toggle
      const closeMobileMenu = () => {
        mobileMenu?.classList.remove('is-open');
        mobileBtn?.setAttribute('aria-expanded', 'false');
        mobileIconOpen?.classList.remove('hidden');
        mobileIconClose?.classList.add('hidden');
        mobileSubmenus.forEach((detail) => detail.removeAttribute('open'));
      };

      mobileBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.contains('is-open');
        if (isOpen) {
          closeMobileMenu();
          return;
        }
        mobileMenu?.classList.add('is-open');
        mobileBtn?.setAttribute('aria-expanded', 'true');
        mobileIconOpen?.classList.add('hidden');
        mobileIconClose?.classList.remove('hidden');
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });

      // Mobile Submenus Accordion behavior
      mobileSubmenus.forEach((submenu) => {
        submenu.addEventListener('toggle', () => {
          if (!(submenu instanceof HTMLDetailsElement) || !submenu.open) {
            return;
          }
          mobileSubmenus.forEach((otherSubmenu) => {
            if (otherSubmenu !== submenu && otherSubmenu instanceof HTMLDetailsElement) {
              otherSubmenu.removeAttribute('open');
            }
          });
        });
      });

      // Desktop Mega-menus
      const menuContainers = Array.from(header.querySelectorAll('.group\\/menu'));
      const triggers = Array.from(header.querySelectorAll('[data-menu-trigger]'));
      const panels = Array.from(header.querySelectorAll('[data-menu-panel]'));
      const chevrons = Array.from(header.querySelectorAll('[data-menu-chevron]'));

      let leaveTimeout = null;

      const setPanelState = (key, isOpen) => {
        const panel = panels.find((item) => item.getAttribute('data-menu-panel') === key);
        const trigger = triggers.find((item) => item.getAttribute('data-menu-trigger') === key);
        const chevron = chevrons.find((item) => item.getAttribute('data-menu-chevron') === key);

        if (!panel || !trigger) {
          return;
        }

        panel.classList.toggle('pointer-events-none', !isOpen);
        panel.classList.toggle('invisible', !isOpen);
        panel.classList.toggle('opacity-0', !isOpen);
        panel.classList.toggle('translate-y-1', !isOpen);

        panel.classList.toggle('pointer-events-auto', isOpen);
        panel.classList.toggle('visible', isOpen);
        panel.classList.toggle('opacity-100', isOpen);
        panel.classList.toggle('translate-y-0', isOpen);

        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        chevron?.classList.toggle('rotate-180', isOpen);
      };

      const closeAllPanels = (exceptKey) => {
        triggers.forEach((trigger) => {
          const key = trigger.getAttribute('data-menu-trigger');
          if (!key || key === exceptKey) {
            return;
          }
          setPanelState(key, false);
        });
      };

      // Hover and Click events with graceful intent timeout
      menuContainers.forEach((container) => {
        const key = container.getAttribute('data-menu-key');
        if (!key) return;

        container.addEventListener('mouseenter', () => {
          if (window.innerWidth < 1024) return;
          if (leaveTimeout) clearTimeout(leaveTimeout);
          closeAllPanels(key);
          setPanelState(key, true);
        });

        container.addEventListener('mouseleave', () => {
          if (window.innerWidth < 1024) return;
          if (leaveTimeout) clearTimeout(leaveTimeout);
          leaveTimeout = setTimeout(() => {
            setPanelState(key, false);
          }, 150);
        });
      });

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.stopPropagation();
          const key = trigger.getAttribute('data-menu-trigger');
          if (!key) return;

          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          closeAllPanels();
          setPanelState(key, !isOpen);
        });
      });

      // Close on outside click
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Node && !header.contains(target)) {
          closeMobileMenu();
          closeAllPanels();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileMenu();
          closeAllPanels();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderMenus, { once: true });
    } else {
      initHeaderMenus();
    }
  })();
</script>
