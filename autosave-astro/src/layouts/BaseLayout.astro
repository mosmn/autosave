---
import SEO from '../components/SEO.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import type { Language } from '../lib/i18n';
import { getContentByLanguage } from '../lib/content';
import { normalizeSeoMeta } from '../lib/seo-meta-normalization';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  lang: Language;
  ogImage?: string;
  ogType?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  ogImage,
  ogType,
  keywords,
  noindex,
} = Astro.props;

const canonicalUrl = Astro.url.href;
const content = getContentByLanguage(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const normalizedSeoMeta = normalizeSeoMeta({
  title,
  description,
  lang,
  keywords,
});
const normalizedTitle = normalizedSeoMeta.title;
const normalizedDescription = normalizedSeoMeta.description;

// Google Fonts — Outfit (display), Source Serif 4 (body), IBM Plex Sans Arabic
const fontUrl =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap';
---

<!doctype html>
<html lang={lang} dir={dir}>
   <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-K9P6ZHLC');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9467XFRGK1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9467XFRGK1');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="aXB6j89WeBVv8e_sQZ3L04YH14uxVfji0t4wSvcTnmQ" />

    <title>{normalizedTitle}</title>

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontUrl} rel="stylesheet" />

    {/* SEO head tags */}
    <SEO
      title={normalizedTitle}
      description={normalizedDescription}
      currentLang={lang}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      keywords={keywords}
      noindex={noindex}
    />

    {/* JSON-LD structured data */}
    <LocalBusinessSchema lang={lang} />

    {/* Sitemap discovery */}
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  </head>
   <body class="font-sans antialiased min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K9P6ZHLC"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />

    {/* Scroll-triggered animation observer */}
    <script is:inline>
      (function() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        function observe() {
          document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observe);
        } else {
          observe();
        }
      })();
    </script>
  </body>
</html>
