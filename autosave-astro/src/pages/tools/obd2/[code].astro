---
import PageLayout from '@/layouts/PageLayout.astro';
import FreonSchema from '@/components/tools/FreonSchema.astro';
import { getAllOBDCodes, type OBDCodeItem } from '@/data/obd-codes';
import { WHATSAPP_NUMBER } from '@/lib/whatsapp';

export function getStaticPaths() {
  const codes = getAllOBDCodes();
  return codes.map((item: OBDCodeItem) => ({
    params: { code: item.code.toLowerCase() },
    props: { item },
  }));
}

type Props = {
  item: OBDCodeItem;
};

const { item } = Astro.props as Props;
const lang = 'ar' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';

const title = `كود ${item.code} مكيف السيارة: التشخيص والأسباب | اوتو سيف`;
const description = `دليل شامل لكود عطل المكيف ${item.code}: معناه، أسبابه، أعراضه، هل الكود طبيعي في الظل، خطوات الفحص، وتكلفة الإصلاح التقديرية بالريال في الرياض.`;
const keywords = [
  `كود ${item.code}`,
  `كود عطل ${item.code}`,
  `رمز عطل المكيف ${item.code}`,
  `كود ${item.code} تويوتا`,
  `كود ${item.code} لكزس`,
  `اصلاح كود ${item.code}`,
  'فحص كمبيوتر مكيف السيارة بالرياض',
  'تشخيص اعطال المكيف',
];

const breadcrumbs = [
  { name: 'الرئيسية', url: `${site}/` },
  { name: 'الأدوات', url: `${site}/tools/` },
  { name: 'أكواد أعطال التكييف OBD-II', url: `${site}/tools/obd2/` },
  { name: `كود ${item.code}`, url: `${site}/tools/obd2/${item.code.toLowerCase()}/` },
];

const allOtherCodes = getAllOBDCodes().filter((c: OBDCodeItem) => c.code !== item.code);

const whatsappMsg = `السلام عليكم ورحمه الله وبركاته\nظهر لي كود عطل المكيف [${item.code}] (${item.titleAr}) في سيارتي، وأرغب في حجز موعد لفحص كمبيوتر التكييف وتشخيص العطل في ورشة أوتو سيف بالرياض.`;
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMsg)}`;

const severityBadge =
  item.severity === 'critical'
    ? 'bg-rose-500/15 text-rose-600 dark:text-rose-400 border-rose-500/30'
    : item.severity === 'high'
    ? 'bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/30'
    : 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/30';

const severityLabel =
  item.severity === 'critical'
    ? 'خطر حرج - أطفئ المكيف فوراً'
    : item.severity === 'high'
    ? 'عطل مؤثر على التبريد'
    : 'بسيط / طبيعي أحياناً';
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/tools/obd2/${item.code.toLowerCase()}/`}
    breadcrumbs={breadcrumbs}
    faqs={item.faqs.map((f) => ({ question: f.qAr, answer: f.aAr }))}
    lang={lang}
  />

  {/* Hero Header */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-primary transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/tools/" class="hover:text-primary transition-colors">الأدوات</a>
        <span>/</span>
        <a href="/tools/obd2/" class="hover:text-primary transition-colors">أكواد التكييف OBD-II</a>
        <span>/</span>
        <span class="text-foreground">كود {item.code}</span>
      </nav>

      {/* Main Code Title Box */}
      <div class="rounded-3xl border border-border bg-card p-6 sm:p-10 shadow-lg">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="font-mono text-3xl sm:text-5xl font-black text-primary tracking-wider">
              {item.code}
            </span>
            <div class="flex flex-col">
              <span class="text-xs uppercase font-bold text-muted-foreground">{item.system}</span>
              <div class="flex items-center gap-2 mt-1">
                <span class={`inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-bold border ${severityBadge}`}>
                  {severityLabel}
                </span>
                {item.isFalseAlarmInShade && (
                  <span class="inline-flex items-center rounded-md bg-amber-500/15 px-2.5 py-0.5 text-xs font-bold text-amber-600 dark:text-amber-400 border border-amber-500/30">
                    ⚠️ طبيعي في الظل
                  </span>
                )}
              </div>
            </div>
          </div>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow hover:bg-emerald-700 transition-colors"
          >
            <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z" />
            </svg>
            حجز فحص كمبيوتر للكود {item.code}
          </a>
        </div>

        <h1 class="mt-6 text-2xl sm:text-3xl font-extrabold text-foreground font-display">
          {item.titleAr}
        </h1>

        <p class="mt-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
          {item.descriptionAr}
        </p>

        {/* Prominent False Alarm Banner */}
        {item.isFalseAlarmInShade && item.falseAlarmNoticeAr && (
          <div class="mt-6 rounded-2xl bg-amber-500/10 border-2 border-amber-500/30 p-4 sm:p-5">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚠️</span>
              <div>
                <h3 class="text-sm font-bold text-amber-900 dark:text-amber-200">
                  تنبيه هام جداً لأصحاب السيارات (وفر فلوسك):
                </h3>
                <p class="mt-1 text-xs sm:text-sm text-amber-800 dark:text-amber-300 leading-relaxed">
                  {item.falseAlarmNoticeAr}
                </p>
              </div>
            </div>
          </div>
        )}

        {/* Quick Specs 4-Box Grid */}
        <div class="mt-8 grid gap-4 grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-border bg-background p-4">
            <span class="text-xs text-muted-foreground block">هل يمكن القيادة؟</span>
            <span class="mt-1 font-bold text-sm text-foreground flex items-center gap-1">
              {item.canDrive ? '✅ نعم، آمنة' : '❌ لا، أطفئ المكيف'}
            </span>
          </div>

          <div class="rounded-2xl border border-border bg-background p-4">
            <span class="text-xs text-muted-foreground block">التكلفة التقديرية</span>
            <span class="mt-1 font-bold text-sm text-primary">
              {item.estimatedRepairCostSAR.min} - {item.estimatedRepairCostSAR.max} ريال
            </span>
          </div>

          <div class="rounded-2xl border border-border bg-background p-4">
            <span class="text-xs text-muted-foreground block">السيارات الشائعة</span>
            <span class="mt-1 font-bold text-sm text-foreground">
              {item.commonBrands.join('، ')}
            </span>
          </div>

          <div class="rounded-2xl border border-border bg-background p-4">
            <span class="text-xs text-muted-foreground block">تصنيف المنظومة</span>
            <span class="mt-1 font-bold text-sm text-foreground capitalize">
              {item.category}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Technical Details: Symptoms, Causes, Diagnostic Steps */}
  <section class="py-12 bg-card border-y border-border">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-10">
      {/* 1. Symptoms */}
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-foreground font-display flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-rose-500"></span>
          أعراض ظهور كود {item.code} على مكيف السيارة:
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {item.symptomsAr.map((symptom) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-border bg-background p-3.5 text-xs sm:text-sm text-muted-foreground">
              <span class="text-rose-500 font-bold shrink-0">⚠️</span>
              <span>{symptom}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* 2. Possible Causes */}
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-foreground font-display flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-amber-500"></span>
          أسباب تسجيل كود {item.code} بالكمبيوتر:
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {item.possibleCausesAr.map((cause) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-border bg-background p-3.5 text-xs sm:text-sm text-muted-foreground">
              <span class="text-amber-500 font-bold shrink-0">🔍</span>
              <span>{cause}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* 3. Diagnostic Steps */}
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-foreground font-display flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-primary"></span>
          خطوات الفحص والتشخيص المعتمدة في أوتو سيف الرياض:
        </h2>
        <ol class="mt-4 space-y-3">
          {item.diagnosticStepsAr.map((step, idx) => (
            <li class="flex items-start gap-3 rounded-2xl border border-border bg-background p-4 text-xs sm:text-sm text-foreground">
              <span class="size-6 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center shrink-0 text-xs">
                {idx + 1}
              </span>
              <span class="leading-relaxed">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      {/* 4. Parts and Repair Notice */}
      <div class="rounded-3xl border border-primary/20 bg-gradient-to-r from-primary/5 via-card to-card p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-bold text-primary uppercase">نصيحة المهندس العاجلة:</span>
            <p class="mt-1 text-sm font-bold text-foreground">{item.urgentActionAr}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="text-xs text-muted-foreground self-center">القطع المرتبطة:</span>
              {item.relatedPartsAr.map((part) => (
                <span class="rounded-lg bg-muted px-2.5 py-1 text-xs font-semibold text-foreground">
                  {part}
                </span>
              ))}
            </div>
          </div>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-2 rounded-2xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow hover:bg-emerald-700 transition-colors"
          >
            طلب تسعيرة القطع والإصلاح
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* FAQs Section */}
  <section class="py-12 bg-background">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl sm:text-2xl font-bold text-foreground font-display text-center mb-6">
        أسئلة متكررة حول كود {item.code}
      </h2>
      <div class="space-y-4">
        {item.faqs.map((faq) => (
          <details class="group rounded-2xl border border-border bg-card p-5 open:border-primary/40">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-foreground text-sm sm:text-base">
              <span>{faq.qAr}</span>
              <span class="text-primary transition group-open:rotate-180">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-muted-foreground leading-relaxed pt-2 border-t border-border">
              {faq.aAr}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* Other Codes Navigation */}
  <section class="py-12 bg-card border-t border-border">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-foreground font-display">أكواد أعطال تكييف أخرى قد تهمك:</h3>
        <a href="/tools/obd2/" class="text-xs font-semibold text-primary hover:underline">
          عرض جميع الأكواد &larr;
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {allOtherCodes.slice(0, 8).map((other) => (
          <a
            href={`/tools/obd2/${other.code.toLowerCase()}/`}
            class="rounded-xl border border-border bg-background p-3 hover:border-primary transition-all text-center group"
          >
            <span class="font-mono text-base font-bold text-foreground group-hover:text-primary transition-colors block">
              {other.code}
            </span>
            <span class="text-[11px] text-muted-foreground line-clamp-1 mt-0.5">
              {other.system}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
