---
import PageLayout from '../../../layouts/PageLayout.astro';
import FreonCalculatorWidget from '../../../components/tools/FreonCalculatorWidget.astro';
import FreonSchema from '../../../components/tools/FreonSchema.astro';
import { getAllFreonSpecs, getAllFreonBrands } from '../../../data/freon-specs';
import { WHATSAPP_NUMBER } from '../../../lib/whatsapp';

const lang = 'ar' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';
const specs = getAllFreonSpecs();
const brands = getAllFreonBrands();

const title = 'حاسبة وجدول كمية فريون السيارات بالجرام ونوع الزيت | اوتو سيف';
const description =
  'جدول وحاسبة كمية فريون مكيف السيارات بالجرام ونوع الغاز R134a أو R1234yf مع لزوجة زيت الكمبروسر لجميع أنواع السيارات في السعودية. تعبئة بميزان إلكتروني في الرياض.';
const keywords = [
  'جدول كمية فريون السيارات',
  'كمية فريون مكيف السيارة بالجرام',
  'نوع فريون السيارة',
  'كم جرام فريون كامري',
  'كمية فريون لاندكروزر مكيفين',
  'كم علبة فريون النترا',
  'زيت كمبروسر المكيف PAG 46',
  'تعبئة فريون بميزان الكتروني الرياض',
  'فحص تسريب فريون ليزر',
];

const breadcrumbs = [
  { name: 'الرئيسية', url: `${site}/` },
  { name: 'الأدوات', url: `${site}/tools/` },
  { name: 'حاسبة كمية فريون السيارات', url: `${site}/tools/freon-capacity/` },
];

const faqs = [
  {
    question: 'كيف أعرف كمية الفريون الموصى بها لسيارتي؟',
    answer:
      'يمكنك معرفة الكمية الدقيقة بالجرام إما من خلال الملصق الموجود أسفل كبوت السيارة (Under-hood AC Sticker)، أو باستخدام حاسبة أوتو سيف أعلاه التي توفر بيانات المصنع الدقيقة لجميع السيارات الواردة للسوق السعودي.',
  },
  {
    question: 'لماذا يعتبر شحن الفريون بالجرام عبر الميزان الإلكتروني أفضل من العلب العشوائية؟',
    answer:
      'لأن كمبروسرات السيارات الحديثة (بأنظمة البلف الإلكتروني) حساسة جداً لفروقات الضغط. نقص 50 جرام يسبب هواء حار عند التوقف في زحمة الصيف، بينما زيادة 50 جرام ترفع ضغط الهاي سايد (High-side) وتسبب فصل الكمبروسر أو انفجار الصوفة.',
  },
  {
    question: 'ما الفرق بين فريون R134a وفريون R1234yf وهل يجوز خلطهما؟',
    answer:
      'فريون R1234yf هو غاز صديق للبيئة معتمد في معظم السيارات الحديثة من عام 2021 فما فوق، بينما R134a هو الغاز التقليدي. يمنع منعاً باتاً خلط الغازين نظراً لاختلاف الضغوط وتركيبة الزيوت ونقاط الاشتعال.',
  },
  {
    question: 'هل تحتاج السيارة تعبئة فريون دورية كل سنة؟',
    answer:
      'دورة تكييف السيارة نظام مغلق ومحكم (Closed Loop) لا يستهلك الفريون ولا ينقص إلا بوجود تسريب حقيقي. إذا نقص الفريون لديك، فالحل الصحيح هو فحص التسريب بالليزر وإصلاحه أولاً قبل التعبئة.',
  },
  {
    question: 'كم علبة فريون تاخذ السيارة العادية والسيارة ذات المكيفين؟',
    answer:
      'السيارة السيدان العادية تاخذ بين 400 إلى 550 جرام (ما يعادل علبة ونصف إلى علبتين صغيرتين تقريباً)، بينما سيارات الدفع الرباعي الكبيرة بمكيفين (مثل لاندكروزر وتاهو وباترول) تاخذ بين 900 إلى 1050 جرام.',
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/tools/freon-capacity/`}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-primary transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/tools/" class="hover:text-primary transition-colors">الأدوات</a>
        <span>/</span>
        <span class="text-foreground">حاسبة كمية فريون السيارات</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          أداة مرجعية متخصصة
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-4xl lg:text-5xl">
          حاسبة وجدول كمية فريون السيارات بالجرام ونوع الزيت
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg leading-relaxed">
          دليلك الفني الشامل لمعرفة سعة غاز الفريون الصحيحة لسيارتك بالجرام (Grams)، نوع الغاز (<code class="font-mono text-primary font-bold">R134a</code> أو <code class="font-mono text-emerald-600 font-bold">R1234yf</code>)، ومواصفات زيت الكمبروسر (<code class="font-mono text-foreground font-semibold">PAG 46 / PAG 100</code>) وضغوط التشغيل الموصى بها في حرارة صيف الرياض.
        </p>
      </div>

      {/* The Interactive Calculator Component */}
      <div class="mt-8">
        <FreonCalculatorWidget lang={lang} />
      </div>
    </div>
  </section>

  {/* Quick Brand Jump Grid */}
  <section class="py-10 border-t border-border bg-secondary/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display text-foreground sm:text-2xl">تصفح كميات الفريون حسب الشركة المصنعة</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-0.5">اختر ماركة سيارتك لعرض جدول الموديلات وسعات التبريد</p>
        </div>
        <span class="text-xs font-semibold text-primary">{brands.length} شركة مصنعة</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {brands.map((b) => (
          <a
            href={`/car-ac/${b.brandSlug}/`}
            class="flex flex-col items-center justify-center rounded-xl border border-border bg-card p-4 text-center transition hover:border-primary/50 hover:bg-primary/5 group"
          >
            <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors">
              {b.brandNameAr}
            </span>
            <span class="text-[11px] text-muted-foreground mt-1">
              {b.count} موديلات متوفرة
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Comprehensive Reference Table for SEO & Crawlers */}
  <section class="py-12 border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          جدول كمية فريون مكيف السيارات الأكثر شيوعاً في السعودية
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          بيانات معتمدة من كتالوجات الوكالات الرسمية لموديلات الخليج (GCC Specs) لضمان أقصى كفاءة تبريد:
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
        <table class="w-full text-start text-sm">
          <thead class="border-b border-border bg-secondary/50 text-xs font-bold text-foreground uppercase">
            <tr>
              <th scope="col" class="px-4 py-3.5 text-start">السيارة والموديل</th>
              <th scope="col" class="px-4 py-3.5 text-start">سنوات الصنع</th>
              <th scope="col" class="px-4 py-3.5 text-center">نوع الغاز</th>
              <th scope="col" class="px-4 py-3.5 text-center">كمية الفريون (جرام)</th>
              <th scope="col" class="px-4 py-3.5 text-center">سعة المكيفين (Dual AC)</th>
              <th scope="col" class="px-4 py-3.5 text-start">نوع ولزوجة الزيت</th>
              <th scope="col" class="px-4 py-3.5 text-center">صفحة الموديل</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border font-medium">
            {specs.map((spec) => (
              <tr class="hover:bg-secondary/30 transition-colors">
                <td class="px-4 py-3.5 font-bold text-foreground whitespace-nowrap">
                  {spec.brandNameAr} {spec.modelNameAr}
                  <span class="block text-xs font-normal text-muted-foreground font-mono">{spec.brandNameEn} {spec.modelNameEn}</span>
                </td>
                <td class="px-4 py-3.5 text-muted-foreground text-xs whitespace-nowrap">
                  {spec.defaultGeneration.years}
                </td>
                <td class="px-4 py-3.5 text-center">
                  <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-bold ${spec.defaultGeneration.refrigerantType === 'R1234yf' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400' : 'bg-primary/15 text-primary'}`}>
                    {spec.defaultGeneration.refrigerantType}
                  </span>
                </td>
                <td class="px-4 py-3.5 text-center font-mono font-bold text-foreground">
                  {spec.defaultGeneration.capacityGrams} g
                  <span class="block text-[11px] font-normal text-muted-foreground">± {spec.defaultGeneration.toleranceGrams}g</span>
                </td>
                <td class="px-4 py-3.5 text-center font-mono">
                  {spec.defaultGeneration.capacityGramsDualAc ? (
                    <span class="font-bold text-foreground">{spec.defaultGeneration.capacityGramsDualAc} g</span>
                  ) : (
                    <span class="text-xs text-muted-foreground">-</span>
                  )}
                </td>
                <td class="px-4 py-3.5 text-xs text-muted-foreground">
                  <span class="font-semibold text-foreground block">{spec.defaultGeneration.oilType}</span>
                  <span>{spec.defaultGeneration.oilCapacityMl} ml</span>
                </td>
                <td class="px-4 py-3.5 text-center whitespace-nowrap">
                  <a
                    href={`/tools/freon-capacity/${spec.brandSlug}/${spec.modelSlug}/`}
                    class="inline-flex items-center gap-1 rounded-lg border border-primary/30 px-2.5 py-1 text-xs font-semibold text-primary hover:bg-primary/10 transition"
                  >
                    <span>التفاصيل</span>
                    <svg class="size-3 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* In-Depth Educational Guide (Huge for SEO & Authority) */}
  <section class="py-14 bg-secondary/20 border-t border-border">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div>
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          دليل صيانة وشحن فريون مكيف السيارات في أجواء الخليج
        </h2>
        <p class="mt-3 text-base text-muted-foreground leading-relaxed">
          في درجات حرارة تتجاوز 45 إلى 50 درجة مئوية في صيف المملكة العربية السعودية، تعمل دورة تكييف السيارة تحت ضغوط وحرارة قصوى. لا مجال هنا للتقديرات التقريبية؛ ففارق 50 جراماً فقط قد يعني الفرق بين تبريد ثلجي منعش أو توقف كامل للكمبروسر.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-bold text-foreground text-lg flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-rose-500/10 text-rose-600 text-sm font-bold">1</span>
            مخاطر الشحن الزائد للفريون (Overcharge)
          </h3>
          <ul class="mt-3 space-y-2 text-xs text-muted-foreground leading-relaxed">
            <li>• ارتفاع ضغط خط الطرد (High-Side) فوق 300 PSI مما يفصل حساس الأمان.</li>
            <li>• عدم وجود مساحة كافية للغاز ليتبخر داخل الثلاجة، مما يسبب خروج هواء حار.</li>
            <li>• حمل إضافي ضخم على محرك السيارة واستهلاك وقود أعلى.</li>
            <li>• احتمال ارتداد سائل الفريون للكمبروسر وكسر البساتم الداخلية.</li>
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-bold text-foreground text-lg flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 text-sm font-bold">2</span>
            مخاطر نقص الفريون والتسريب (Undercharge)
          </h3>
          <ul class="mt-3 space-y-2 text-xs text-muted-foreground leading-relaxed">
            <li>• ضعف التبريد وخاصة أثناء وقوف السيارة عند الإشارات أو في الزحام.</li>
            <li>• خروج هواء بارد من جهة السائق وهواء دافئ من جهة الراكب.</li>
            <li>• عدم تزييت الكمبروسر بشكل صحيح لأن زيت التبريد يسري مع الفريون.</li>
            <li>• تجمد ثلاجة المكيف وانسداد فتحات خروج الهواء بالجليد.</li>
          </ul>
        </div>
      </div>

      {/* Laser Leak Detection Feature */}
      <div class="rounded-2xl border border-primary/30 bg-card p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-2">
              تقنية حصرية لدى أوتو سيف
            </span>
            <h3 class="text-xl font-bold font-display text-foreground">
              لا تعبئ فريون قبل فحص التسريب بالليزر!
            </h3>
            <p class="mt-2 text-sm text-muted-foreground max-w-2xl leading-relaxed">
              إذا كان مكيفك ينقص فريون، فإعادة تعبئته بدون كشف مكان التهريب هو إهدار للمال. نوفر في مركزنا بالرياض أحدث أجهزة الفحص بالليزر والموجات فوق الصوتية لكشف أدق مسامات التهريب في الرديتر، الثلاجة، وخراطيم التكييف مع ضمان مكتوب.
            </p>
          </div>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('السلام عليكم ورحمه الله وبركاته\nأرغب في حجز موعد فحص تسريب فريون بالليزر لسيارتي في ورشة أوتو سيف بالرياض.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-xs font-bold text-primary-foreground transition hover:bg-primary/90 whitespace-nowrap shadow-sm"
          >
            <span>احجز فحص ليزر الآن</span>
            <svg class="size-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      {/* FAQ Section */}
      <div>
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl mb-6">
          الأسئلة الشائعة حول كميات وأنواع فريون السيارات
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-border bg-card p-5">
              <h3 class="font-bold text-foreground text-base sm:text-lg">{faq.question}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>
