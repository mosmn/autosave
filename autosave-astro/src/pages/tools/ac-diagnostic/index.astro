---
import PageLayout from '../../../layouts/PageLayout.astro';
import ACDiagnosticWizard from '../../../components/tools/ACDiagnosticWizard.astro';
import FreonSchema from '../../../components/tools/FreonSchema.astro';
import { diagnosticTree } from '../../../data/diagnostic-tree';
import { WHATSAPP_NUMBER } from '../../../lib/whatsapp';

const lang = 'ar' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';

const title = 'أداة الفحص والتشخيص الذكي لأعطال مكيف السيارة | اوتو سيف';
const description =
  'شخص عطل مكيف سيارتك بنفسك فورياً: أسباب ضعف التبريد في الوقوف، خروج هواء حار، الأصوات الغريبة أو الروائح الكريهة مع تقدير تكلفة الإصلاح في الرياض.';
const keywords = [
  'تشخيص اعطال مكيف السيارة',
  'فحص مكيف السيارة اون لاين',
  'المكيف يبرد في الخط ويوقف بالزحمة',
  'مكيف السيارة يطلع هواء حار',
  'مكيف السيارة يبرد جهة وجهة حار',
  'صوت ونه مع تشغيل المكيف',
  'صوت طقطقة في مكيف السيارة',
  'تسريب ماء داخل السيارة من المكيف',
  'فحص ليزر تسريب الفريون الرياض',
];

const breadcrumbs = [
  { name: 'الرئيسية', url: `${site}/` },
  { name: 'الأدوات', url: `${site}/tools/` },
  { name: 'أداة التشخيص الذكي لأعطال المكيف', url: `${site}/tools/ac-diagnostic/` },
];

const faqs = [
  {
    question: 'كيف أعرف هل المشكلة من بلف الكمبروسر أو الكمبروسر كامل؟',
    answer:
      'إذا كان مكيف السيارة يبرد بشكل ممتاز على الطرق السريعة ويتحول لهواء حار أو دافئ عند التوقف في الإشارة، ففي 85% من سيارات تويوتا وهيونداي وكيا ونيسان الحديثة تكون المشكلة في بلف التحكم الإلكتروني (Control Valve) فقط ولا يحتاج الكمبروسر للتغيير.',
  },
  {
    question: 'لماذا يبرد المكيف من جهة السائق ويخرج هواء دافئ من جهة الراكب؟',
    answer:
      'يحدث هذا لسببين رئيسيين: إما نقص جزئي في غاز الفريون حيث يتبخر الغاز في نصف الثلاجة الأول فقط، أو انكسار مسننات بوابة خلط الهواء (Blend Door Actuator) المسؤولة عن جهة الراكب.',
  },
  {
    question: 'هل تعبئة الفريون تحل مشكلة ضعف التبريد دائماً؟',
    answer:
      'لا! تعبئة الفريون دون فحص مصدر التهريب بالليزر يعتبر إهداراً للمال. إذا كان الفريون ناقصاً فمعنى ذلك وجود تهريب يجب إصلاحه أولاً، وإلا سيتسرب الغاز الجديد خلال أيام أو أسابيع.',
  },
  {
    question: 'ما سبب خروج رائحة كريهة أو رطوبة عند تشغيل المكيف؟',
    answer:
      'السبب هو تراكم الأتربة والرطوبة على ثلاجة المكيف مما يكون بيئة خصبة للبكتيريا والفطريات، بالإضافة إلى اتساخ فلتر المكيف. الحل هو استبدال الفلتر وإجراء تعقيم كيميائي لمجاري الهواء.',
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/tools/ac-diagnostic/`}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-primary transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/tools/" class="hover:text-primary transition-colors">الأدوات</a>
        <span>/</span>
        <span class="text-foreground">التشخيص الذكي لأعطال المكيف</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          أداة تشخيص الأعطال الفورية
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-4xl lg:text-5xl">
          أداة الفحص والتشخيص الذكي لأعطال مكيف السيارة
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg leading-relaxed">
          وفرنا لك هذا النظام الذكي لمساعدتك في فهم العطل الحقيقي لمكيف سيارتك قبل الذهاب للورش، لحمايتك من التشخيصات الخاطئة وتغيير قطع لا تحتاجها.
        </p>
      </div>

      {/* The Diagnostic Wizard Widget */}
      <div class="mt-8">
        <ACDiagnosticWizard lang={lang} />
      </div>
    </div>
  </section>

  {/* Common Diagnostic Cases Overview */}
  <section class="py-12 border-t border-border bg-secondary/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          أشهر حالات أعطال المكيف وطرق علاجها
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          نظرة سريعة على الأعطال الأكثر تكراراً في ورشة أوتو سيف بالرياض:
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {diagnosticTree.map((item) => (
          <div class="rounded-xl border border-border bg-card p-5 transition hover:border-primary/40 shadow-sm">
            <div class="flex items-center gap-3 mb-3">
              <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary shrink-0">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="font-bold text-foreground text-sm">{item.titleAr}</h3>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              {item.shortDescAr}
            </p>
            <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-[11px]">
              <span class="text-primary font-semibold">احتمال عطل الصمام أو المراوح</span>
              <span class="text-muted-foreground">فحص دقيق</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* FAQs */}
  <section class="py-14 border-t border-border">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div>
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          الأسئلة الشائعة حول تشخيص أعطال مكيف السيارة
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          إجابات مهندسي أوتو سيف على أهم التساؤلات الفنية:
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <h3 class="font-bold text-foreground text-base sm:text-lg">{faq.question}</h3>
            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>

      {/* Workshop Booking Banner */}
      <div class="rounded-2xl border border-primary/30 bg-primary/5 p-6 sm:p-8 mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-xl font-bold text-foreground">هل تحتاج فحصاً ميكانيكياً دقيقاً في الرياض؟</h3>
          <p class="mt-1 text-xs sm:text-sm text-muted-foreground">
            تفضل بزيارة مركزنا لإجراء فحص ليزر شامل مع تقرير فني وضمان أفضل سعر.
          </p>
        </div>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('السلام عليكم ورحمه الله وبركاته\nأرغب بحجز موعد فحص مكيف شامل لسيارتي في ورشة أوتو سيف بالرياض.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-xs font-bold text-primary-foreground shadow-md transition hover:bg-primary/90 whitespace-nowrap"
        >
          <span>احجز موعدك الآن</span>
          <svg class="size-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</PageLayout>
