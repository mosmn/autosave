---
import PageLayout from '../../layouts/PageLayout.astro';
import { getContentByLanguage } from '../../lib/content';
import { getLocalizedPath } from '../../lib/i18n';
import ComingSoonLink from '../../components/ComingSoonLink.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { services } from '../../data/services';
import { components as acComponents } from '../../data/components';
import { getDropOffWhatsAppUrl, getGeneralContactWhatsAppUrl, getPickupReturnWhatsAppUrl } from '../../lib/whatsapp';

const lang = 'en' as const;
const content = getContentByLanguage(lang);
const dropOffBookingUrl = getDropOffWhatsAppUrl(lang);
const pickupBookingUrl = getPickupReturnWhatsAppUrl(lang);
const contactWhatsAppUrl = getGeneralContactWhatsAppUrl(lang);
const pricingPageUrl = 'https://autosaveks.com/en/pricing';
const serviceLowPrice = Math.min(...services.map((service) => service.priceRangeMin));
const serviceHighPrice = Math.max(...services.map((service) => service.priceRangeMax));
const aggregateRating = {
  ratingValue: '4.8',
  reviewCount: '320',
  ratingCount: '320',
  bestRating: '5',
  worstRating: '1',
};

const pricingFaqs = [
  {
    question: 'How much does car AC repair cost in Saudi Arabia?',
    answer: 'Repair cost depends on the issue type, system condition, and vehicle model. Final details are shared after technical inspection.',
  },
  {
    question: 'Do your prices include parts and labor?',
    answer: 'Service fees cover service workflow management and quality assurance. Parts and labor are explained separately after diagnosis.',
  },
  {
    question: 'How do you guarantee the best price on spare parts?',
    answer: 'We compare prices from multiple certified suppliers for the same part and select the best value with guaranteed quality. If you find a lower price, we refund the difference within 48 hours.',
  },
  {
    question: 'Is there a warranty on the repair?',
    answer: 'Yes, all repair work includes a warranty on both service and parts. The warranty duration varies depending on the type of repair and parts used.',
  },
  {
    question: 'What is the difference between Drop-Off and Pickup service?',
    answer: 'With Drop-Off service, you drive your car to the workshop. With Pickup & Return service, we collect your car and return it after repair.',
  },
  {
    question: 'Do prices vary by car brand?',
    answer: 'Yes, spare parts prices vary by car make and model. European and luxury vehicles typically cost more than Japanese and Korean cars. Service fees remain the same for all vehicles.',
  },
];
---

<PageLayout
  title="Car AC Repair Prices | AUTO SAVE"
  description="View transparent pricing for car AC repair and maintenance in Saudi Arabia. Freon recharge, compressor replacement, and all AC services with best price guarantee."
  lang={lang}
  keywords={['car AC repair cost', 'car AC service price', 'freon recharge price', 'compressor replacement cost', 'AC spare parts prices Saudi Arabia']}
>
  {/* Hero */}
  <section class="relative overflow-hidden hero-gradient text-[#f0ebe0]">
    <div class="hero-pattern"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl">
        <span class="hero-animate eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-primary">Pricing</span>
        <h1 class="hero-animate hero-animate-delay-1 mt-4 text-4xl font-bold tracking-tight font-display sm:text-5xl">Car AC Repair Prices</h1>
        <p class="hero-animate hero-animate-delay-2 mt-6 text-lg text-[#f0ebe0]/65 leading-relaxed">Transparent, upfront pricing for all car AC repair and maintenance services. We guarantee the best prices on spare parts through certified service centers.</p>
        <p class="hero-animate hero-animate-delay-3 mt-5 text-sm text-[#f0ebe0]/80">
          Customer rating {aggregateRating.ratingValue}/{aggregateRating.bestRating} based on {aggregateRating.reviewCount} reviews.
        </p>
      </div>
    </div>
  </section>

  {/* Service Plans */}
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-animate="fade-in-up">
        <span class="eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-accent">Service Plans</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight font-display sm:text-4xl">Choose the Right Plan for You</h2>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">Both plans include our best price guarantee on spare parts and post-repair quality inspection.</p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
        {/* Drop-Off Plan */}
        <div class="rounded-2xl border border-border bg-card p-8 shadow-sm card-hover-lift" data-animate="fade-in-up">
          <h3 class="text-xl font-bold font-display">Drop-Off Service</h3>
          <p class="mt-2 text-sm text-muted-foreground">Deliver your car to the workshop, and we handle the following maintenance and services.</p>
          <p class="mt-6 text-sm font-semibold text-primary">The following services are free with warranty for our customers</p>
          <ul class="mt-8 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Search for the best parts at the cheapest price, with a guarantee to return triple the price difference if any.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Quality-checked repair</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Dedicated WhatsApp support</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Service warranty included</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Free part delivery to center</span>
            </li>
          </ul>
          <div class="mt-7 rounded-xl border border-primary/25 bg-primary/5 p-4">
            <h4 class="text-sm font-semibold text-foreground mb-2">No upfront cost—pay in flexible installments</h4>
            <p class="text-xs text-muted-foreground mb-3 leading-relaxed">Manage your budget: split the full repair and parts cost into interest-free monthly payments. Pay only what you need, when you need it.</p>
            <p class="text-xs font-medium text-foreground mb-3">Zero-interest partners:</p>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <a
                href="https://tabby.ai/ar-AE"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Pay with Tabby"
                class="inline-flex min-h-11 items-center rounded-lg border border-border bg-white px-3 py-2 transition hover:border-primary/50"
              >
                <img src="/images/tabby.png" alt="Tabby payment logo" width="108" height="36" loading="lazy" class="h-8 w-auto object-contain" />
              </a>
              <a
                href="https://tamara.co/ar-sa"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Pay with Tamara"
                class="inline-flex min-h-11 items-center rounded-lg border border-border bg-white px-3 py-2 transition hover:border-primary/50"
              >
                <img src="/images/tammara.png" alt="Tamara payment logo" width="108" height="36" loading="lazy" class="h-8 w-auto object-contain" />
              </a>
            </div>
          </div>
          <div class="mt-8">
            <ComingSoonLink
              href={dropOffBookingUrl}
              lang={lang}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full rounded-lg border-2 border-primary py-3 text-center text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
            >
              Book Drop-Off
            </ComingSoonLink>
          </div>
        </div>

        {/* Pickup Plan */}
        <div class="relative rounded-2xl border-2 border-primary bg-card p-8 shadow-lg" data-animate="fade-in-up" data-animate-delay="100">
          <div class="absolute -top-4 start-1/2 -translate-x-1/2 rounded-full gold-gradient px-4 py-1 text-xs font-bold text-white">Most Popular</div>
          <h3 class="text-xl font-bold font-display">Pickup & Return</h3>
          <p class="mt-2 text-sm text-muted-foreground">We pick up your car from your door and return it after repair.</p>
          <p class="mt-6 text-sm font-semibold text-primary">Service fee details are shared on request</p>
          <ul class="mt-8 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Door-to-door car pickup</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Search for the best parts at the cheapest price, with a guarantee to return triple the price difference if any.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Quality-checked repair</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Dedicated WhatsApp support</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Service warranty included</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Free part delivery to center</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-sm">Car delivered back to you</span>
            </li>
          </ul>
          <div class="mt-7 rounded-xl border border-primary/25 bg-primary/5 p-4">
            <h4 class="text-sm font-semibold text-foreground mb-2">Spread costs over time—zero interest</h4>
            <p class="text-xs text-muted-foreground mb-3 leading-relaxed">No surprise large bills: divide your total repair and parts investment into comfortable monthly installments at zero percent interest. Approved instantly.</p>
            <p class="text-xs font-medium text-foreground mb-3">Trusted payment plans:</p>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <a
                href="https://tabby.ai/ar-AE"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Pay with Tabby"
                class="inline-flex min-h-11 items-center rounded-lg border border-border bg-white px-3 py-2 transition hover:border-primary/50"
              >
                <img src="/images/tabby.png" alt="Tabby payment logo" width="108" height="36" loading="lazy" class="h-8 w-auto object-contain" />
              </a>
              <a
                href="https://tamara.co/ar-sa"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Pay with Tamara"
                class="inline-flex min-h-11 items-center rounded-lg border border-border bg-white px-3 py-2 transition hover:border-primary/50"
              >
                <img src="/images/tammara.png" alt="Tamara payment logo" width="108" height="36" loading="lazy" class="h-8 w-auto object-contain" />
              </a>
            </div>
          </div>
          <div class="mt-8">
            <ComingSoonLink
              href={pickupBookingUrl}
              lang={lang}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full rounded-lg gold-gradient gold-shimmer py-3 text-center text-sm font-semibold text-white shadow-lg shadow-primary/20 transition hover:shadow-xl"
            >
              Book Pickup
            </ComingSoonLink>
          </div>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-muted-foreground max-w-2xl mx-auto">* All service details are confirmed after initial inspection for full clarity of work scope.</p>
    </div>
  </section>

  {/* Service Details Table */}
  <section class="py-20 lg:py-28 bg-secondary/40">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-animate="fade-in-up">
        <span class="eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-accent">Service Details</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight font-display sm:text-4xl">AC Service Overview</h2>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">General service information and estimated duration. Final scope is confirmed after inspection.</p>
      </div>

      <div class="overflow-x-auto max-w-4xl mx-auto" data-animate="fade-in-up">
        <table class="w-full border-collapse rounded-xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-foreground text-card">
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">Service</th>
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">Est. Duration</th>
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">Notes</th>
              <th class="px-6 py-4 text-center text-sm font-semibold font-display">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {services.map((service, i) => (
              <tr class:list={['transition hover:bg-secondary/60', i % 2 === 0 ? 'bg-card' : 'bg-secondary/20']}>
                <td class="px-6 py-4">
                  <span class="font-semibold text-sm">{service.nameEn}</span>
                </td>
                <td class="px-6 py-4 text-sm text-muted-foreground">
                  {service.durationMinutes >= 60
                    ? `${Math.floor(service.durationMinutes / 60)}h${service.durationMinutes % 60 > 0 ? ` ${service.durationMinutes % 60}m` : ''}`
                    : `${service.durationMinutes} min`}
                </td>
                <td class="px-6 py-4">
                  <span class="font-semibold text-primary text-sm">Confirmed after inspection</span>
                </td>
                <td class="px-6 py-4 text-center">
                  <ComingSoonLink
                    href={getLocalizedPath(`/services/${service.slug}`, lang)}
                    lang={lang}
                    class="text-sm font-medium text-primary hover:underline"
                  >
                    View Details
                  </ComingSoonLink>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Parts Details Table */}
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-animate="fade-in-up">
        <span class="eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-accent">Parts Details</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight font-display sm:text-4xl">AC Spare Parts Information</h2>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">General information about available parts and options. Suitability is confirmed after diagnosis.</p>
      </div>

      <div class="overflow-x-auto max-w-5xl mx-auto" data-animate="fade-in-up">
        <table class="w-full border-collapse rounded-xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-foreground text-card">
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">Part</th>
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">OEM Availability</th>
              <th class="px-6 py-4 text-start text-sm font-semibold font-display">Aftermarket Availability</th>
              <th class="px-6 py-4 text-center text-sm font-semibold font-display">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {acComponents.map((component, i) => (
              <tr class:list={['transition hover:bg-secondary/60', i % 2 === 0 ? 'bg-card' : 'bg-secondary/20']}>
                <td class="px-6 py-4">
                  <span class="font-semibold text-sm">{component.nameEn}</span>
                </td>
                <td class="px-6 py-4 text-sm text-muted-foreground">Available based on vehicle type</td>
                <td class="px-6 py-4">
                  <span class="font-semibold text-primary text-sm">Multiple options after inspection</span>
                </td>
                <td class="px-6 py-4 text-center">
                  <ComingSoonLink
                    href={getLocalizedPath(`/parts/${component.slug}`, lang)}
                    lang={lang}
                    class="text-sm font-medium text-primary hover:underline"
                  >
                    View Details
                  </ComingSoonLink>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Price Guarantee */}
  <section class="py-20 lg:py-28 bg-secondary/40">
    <div class="container mx-auto px-4">
      <div class="grid items-center gap-12 lg:grid-cols-2 max-w-5xl mx-auto">
        <div data-animate="fade-in-up">
          <span class="eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-accent">Price Guarantee</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight font-display sm:text-4xl">Best Price Guarantee on Spare Parts</h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">We search multiple certified suppliers for the same part to find the best price. If you find a lower price for the same part with equal quality, we refund the difference within 48 hours.</p>
          <div class="mt-8 grid grid-cols-2 gap-6">
            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-medium">Multi-supplier comparison</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-medium">Certified suppliers only</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-medium">Difference refund</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-medium">Full transparency</span>
            </div>
          </div>
        </div>
        <div class="rounded-2xl border border-border bg-card p-8 shadow-sm" data-animate="fade-in-up" data-animate-delay="100">
          <h3 class="text-lg font-bold font-display mb-6">How Our Price Guarantee Works</h3>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full gold-gradient text-white text-sm font-bold font-display">1</div>
              <div>
                <h4 class="font-semibold text-sm">We Search & Compare</h4>
                <p class="mt-1 text-sm text-muted-foreground">We contact multiple certified suppliers for the same part and compare prices.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full gold-gradient text-white text-sm font-bold font-display">2</div>
              <div>
                <h4 class="font-semibold text-sm">We Choose the Best</h4>
                <p class="mt-1 text-sm text-muted-foreground">We select the best price while ensuring part quality and compatibility with your car.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full gold-gradient text-white text-sm font-bold font-display">3</div>
              <div>
                <h4 class="font-semibold text-sm">Price Match Promise</h4>
                <p class="mt-1 text-sm text-muted-foreground">Found the same part cheaper elsewhere? We refund the difference within 48 hours.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="py-20 lg:py-28">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-animate="fade-in-up">
        <span class="eyebrow-decorated text-sm font-semibold uppercase tracking-widest text-accent">FAQ</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight font-display sm:text-4xl">Frequently Asked Questions About Pricing</h2>
      </div>
      <div class="mx-auto max-w-3xl space-y-4" data-animate="fade-in-up">
        {pricingFaqs.map((faq) => (
          <details class="group rounded-xl border border-border bg-card p-0 shadow-sm">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-5 font-semibold text-sm font-display list-none [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm text-muted-foreground leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="relative py-20 lg:py-28 overflow-hidden hero-gradient text-[#f0ebe0]">
    <div class="hero-pattern"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <div class="w-16 h-1 gold-gradient mx-auto mb-8 rounded-full" data-animate="scale-in"></div>
      <h2 class="text-3xl font-bold font-display mb-5" data-animate="fade-in-up">Get a Free Consultation</h2>
      <p class="text-lg text-[#f0ebe0]/65 max-w-2xl mx-auto mb-10" data-animate="fade-in-up" data-animate-delay="100">Contact us via WhatsApp for a quick initial diagnosis and service details. No commitment required.</p>
      <ComingSoonLink
        href={contactWhatsAppUrl}
        lang={lang}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-lg gold-gradient gold-shimmer px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/20 transition hover:shadow-xl"
        data-animate="fade-in-up"
        data-animate-delay="200"
      >
        Contact via WhatsApp
      </ComingSoonLink>
    </div>
  </section>

  {/* JSON-LD */}
  <FAQSchema items={pricingFaqs} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${pricingPageUrl}#pricing-product`,
    "mainEntityOfPage": pricingPageUrl,
    "name": "Car AC Repair and Maintenance Services",
    "description": "Car AC repair and maintenance services in Saudi Arabia with best-price guarantee and certified execution quality.",
    "url": pricingPageUrl,
    "brand": {
      "@type": "Brand",
      "name": "AUTO SAVE",
      "url": "https://autosaveks.com"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": aggregateRating.ratingValue,
      "reviewCount": aggregateRating.reviewCount,
      "ratingCount": aggregateRating.ratingCount,
      "bestRating": aggregateRating.bestRating,
      "worstRating": aggregateRating.worstRating
    },
    "areaServed": {
      "@type": "Country",
      "name": "Saudi Arabia"
    },
    "offers": {
      "@type": "AggregateOffer",
      "url": pricingPageUrl,
      "priceCurrency": "SAR",
      "lowPrice": serviceLowPrice,
      "highPrice": serviceHighPrice,
      "offerCount": services.length,
      "itemListElement": services.map(service => ({
        "@type": "Offer",
        "url": pricingPageUrl,
        "itemOffered": {
          "@type": "Service",
          "name": service.nameEn,
        }
      }))
    }
  })} />
</PageLayout>
