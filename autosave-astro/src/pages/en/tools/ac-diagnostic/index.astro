---
import PageLayout from '../../../../layouts/PageLayout.astro';
import ACDiagnosticWizard from '../../../../components/tools/ACDiagnosticWizard.astro';
import FreonSchema from '../../../../components/tools/FreonSchema.astro';
import { diagnosticTree } from '../../../../data/diagnostic-tree';
import { WHATSAPP_NUMBER } from '../../../../lib/whatsapp';

const lang = 'en' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';

const title = 'Smart Car AC Diagnostic Wizard & Symptom Checker | Auto Save KSA';
const description =
  'Diagnose your car air conditioning problem online: Identify causes of weak cooling at idle, warm air, clicking sounds, and musty odors with estimated repair costs.';
const keywords = [
  'car ac diagnostic tool',
  'car ac symptom checker',
  'ac blowing warm at idle',
  'ac cold on highway only',
  'car ac one side cold one side hot',
  'car ac clicking noise',
  'car ac repair cost riyadh',
];

const breadcrumbs = [
  { name: 'Home', url: `${site}/en/` },
  { name: 'Tools', url: `${site}/en/tools/` },
  { name: 'Smart AC Diagnostic', url: `${site}/en/tools/ac-diagnostic/` },
];

const faqs = [
  {
    question: 'How do I know if the issue is just the compressor valve or the entire compressor?',
    answer:
      'If your car AC cools well on the highway but blows warm when stopped in traffic or at red lights, 85% of modern Japanese and Korean vehicles only require an electronic control valve replacement rather than a costly complete compressor.',
  },
  {
    question: 'Why does my AC blow cold on the driver side but warm on the passenger side?',
    answer:
      'This typically indicates either a partial freon leak starving the passenger half of the evaporator core, or stripped gears inside the passenger HVAC blend door actuator.',
  },
  {
    question: 'Does refilling freon always fix weak cooling?',
    answer:
      'No. Automotive AC is a closed system. Recharging freon without laser leak testing wastes money because new gas will leak out again within days if a leak is present.',
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/en/tools/ac-diagnostic/`}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/en/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/en/tools/" class="hover:text-primary transition-colors">Tools</a>
        <span>/</span>
        <span class="text-foreground">Smart AC Diagnostic</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Instant AC Troubleshooting
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-4xl lg:text-5xl">
          Smart Car AC Diagnostic Wizard
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg leading-relaxed">
          Troubleshoot your car air conditioning problem before visiting a repair shop. Get accurate insights into probable mechanical causes, DIY checks, and realistic repair costs.
        </p>
      </div>

      {/* The Diagnostic Wizard Widget */}
      <div class="mt-8">
        <ACDiagnosticWizard lang={lang} />
      </div>
    </div>
  </section>

  {/* Common Diagnostic Cases Overview */}
  <section class="py-12 border-t border-border bg-secondary/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          Common Automotive AC Failure Patterns
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Real-world diagnostics observed at our Riyadh workshop:
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {diagnosticTree.map((item) => (
          <div class="rounded-xl border border-border bg-card p-5 transition hover:border-primary/40 shadow-sm">
            <div class="flex items-center gap-3 mb-3">
              <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary shrink-0">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="font-bold text-foreground text-sm">{item.titleEn}</h3>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              {item.shortDescEn}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
