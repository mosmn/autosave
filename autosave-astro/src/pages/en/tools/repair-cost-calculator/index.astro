---
import PageLayout from '../../../../layouts/PageLayout.astro';
import RepairCostCalculatorWidget from '../../../../components/tools/RepairCostCalculatorWidget.astro';
import FreonSchema from '../../../../components/tools/FreonSchema.astro';
import { serviceJobs, vehicleTiers } from '../../../../data/repair-pricing';
import { WHATSAPP_NUMBER } from '../../../../lib/whatsapp';

const lang = 'en' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';

const title = 'Car AC Repair Cost Estimator & Tabby/Tamara Calculator | Auto Save KSA';
const description =
  'Estimate car AC repair costs in Riyadh: Prices for compressor replacement, evaporator core, condenser, and freon recharge with 4-month zero-interest payment plans via Tabby and Tamara.';
const keywords = [
  'car ac repair cost riyadh',
  'compressor replacement price saudi',
  'tabby car repair riyadh',
  'tamara auto maintenance installment',
  'car ac freon refill price',
  'car evaporator repair cost',
];

const breadcrumbs = [
  { name: 'Home', url: `${site}/en/` },
  { name: 'Tools', url: `${site}/en/tools/` },
  { name: 'Repair Cost & Installment Estimator', url: `${site}/en/tools/repair-cost-calculator/` },
];

const faqs = [
  {
    question: 'How do Tabby and Tamara installments work for car AC repair?',
    answer:
      'You can split your total invoice (including genuine parts and labor) into 4 equal monthly installments with 0% interest and no hidden fees. Pay 25% on delivery day, and the remaining 3 payments are billed monthly through the Tabby or Tamara apps.',
  },
  {
    question: 'What are the requirements for Tabby/Tamara auto repair financing?',
    answer:
      'All you need is a valid Saudi National ID or Iqama, an active mobile number registered under your name, and a debit or credit card (Mada, Visa, Mastercard). Approval is instant inside our Riyadh workshop.',
  },
  {
    question: 'Does the estimated price include parts, labor, freon, and VAT?',
    answer:
      'Yes, the figures generated by the calculator include full estimated project costs: parts, labor, freon/oil consumables, and 15% VAT.',
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/en/tools/repair-cost-calculator/`}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/en/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/en/tools/" class="hover:text-primary transition-colors">Tools</a>
        <span>/</span>
        <span class="text-foreground">Cost & Installment Estimator</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Instant Pricing & Financing
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-4xl lg:text-5xl">
          Car AC Repair Cost & Installment Calculator
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg leading-relaxed">
          Transparent price estimates for automotive air conditioning services in Riyadh, with flexible 4-month zero-interest payment plans powered by Tabby & Tamara.
        </p>
      </div>

      {/* The Calculator Widget */}
      <div class="mt-8">
        <RepairCostCalculatorWidget lang={lang} />
      </div>
    </div>
  </section>

  {/* Services & Price Guide Grid */}
  <section class="py-12 border-t border-border bg-secondary/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          Auto Save Service Pricing Standards
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Guaranteed OEM parts and written warranties across all repairs:
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {serviceJobs.map((job) => (
          <div class="rounded-xl border border-border bg-card p-5 shadow-sm transition hover:border-primary/40">
            <h3 class="font-bold text-foreground text-base">{job.nameEn}</h3>
            <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
              {job.descriptionEn}
            </p>
            <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs">
              <span class="text-primary font-bold">{job.warrantyEn}</span>
              <span class="text-muted-foreground">{job.durationHoursEn}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
