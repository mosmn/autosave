---
import PageLayout from '../../../../layouts/PageLayout.astro';
import FreonCalculatorWidget from '../../../../components/tools/FreonCalculatorWidget.astro';
import FreonSchema from '../../../../components/tools/FreonSchema.astro';
import { getAllFreonSpecs, getAllFreonBrands } from '../../../../data/freon-specs';
import { WHATSAPP_NUMBER } from '../../../../lib/whatsapp';

const lang = 'en' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';
const specs = getAllFreonSpecs();
const brands = getAllFreonBrands();

const title = 'Car AC Freon Capacity Chart & Compressor Oil Specs | Auto Save KSA';
const description =
  'Complete refrigerant capacity guide in grams, gas type (R134a vs R1234yf), and PAG oil specifications for cars in Saudi Arabia. Precision digital scale recharge in Riyadh.';
const keywords = [
  'car ac freon capacity chart',
  'car refrigerant capacity grams',
  'compressor pag oil spec',
  'camry freon grams',
  'land cruiser dual ac freon capacity',
  'r134a vs r1234yf saudi',
  'laser leak test riyadh',
];

const breadcrumbs = [
  { name: 'Home', url: `${site}/en/` },
  { name: 'Tools', url: `${site}/en/tools/` },
  { name: 'Freon Capacity Lookup', url: `${site}/en/tools/freon-capacity/` },
];

const faqs = [
  {
    question: 'How do I find the correct Freon capacity for my car?',
    answer:
      'Check the under-hood AC specification decal in your engine bay, or use the Auto Save interactive calculator above for verified OEM specifications for Saudi/GCC market vehicles.',
  },
  {
    question: 'Why is digital scale charging mandatory over generic cans?',
    answer:
      'Modern clutchless compressors with variable displacement electronic control valves have narrow operating tolerances. Overcharging or undercharging by as little as 40 grams causes system lockouts or warm air at idle.',
  },
  {
    question: 'Can R134a and R1234yf refrigerants be mixed?',
    answer:
      'Never. R1234yf and R134a operate under different thermodynamic curves and use different lubricants. Cross-contamination causes immediate compressor failure and port seal degradation.',
  },
  {
    question: 'Does a car naturally lose Freon each year?',
    answer:
      'No. Automotive air conditioning systems are hermetically sealed closed loops. If refrigerant is low, an active leak exists. Laser leak inspection is essential prior to refilling.',
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/en/tools/freon-capacity/`}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumbs">
        <a href="/en/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/en/tools/" class="hover:text-primary transition-colors">Tools</a>
        <span>/</span>
        <span class="text-foreground">Freon Capacity Lookup</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Technical Reference Tool
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-4xl lg:text-5xl">
          Car AC Refrigerant & Oil Capacity Lookup
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg leading-relaxed">
          Comprehensive technical directory providing exact refrigerant weight in grams, gas specification (<code class="font-mono text-primary font-bold">R134a</code> or <code class="font-mono text-emerald-600 font-bold">R1234yf</code>), compressor lubricant viscosity (<code class="font-mono text-foreground font-semibold">PAG 46 / PAG 100</code>), and recommended summer operating pressures in Saudi Arabia.
        </p>
      </div>

      {/* The Interactive Calculator Component */}
      <div class="mt-8">
        <FreonCalculatorWidget lang={lang} />
      </div>
    </div>
  </section>

  {/* Quick Brand Jump Grid */}
  <section class="py-10 border-t border-border bg-secondary/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display text-foreground sm:text-2xl">Browse Refrigerant Specs by Make</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-0.5">Select your car manufacturer to view model charts</p>
        </div>
        <span class="text-xs font-semibold text-primary">{brands.length} Manufacturers</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {brands.map((b) => (
          <a
            href={`/en/car-ac/${b.brandSlug}/`}
            class="flex flex-col items-center justify-center rounded-xl border border-border bg-card p-4 text-center transition hover:border-primary/50 hover:bg-primary/5 group"
          >
            <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors">
              {b.brandNameEn}
            </span>
            <span class="text-[11px] text-muted-foreground mt-1">
              {b.count} Models Available
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Comprehensive Reference Table for SEO & Crawlers */}
  <section class="py-12 border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          Popular GCC Car AC Freon Capacity Specifications
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Calibrated manufacturer data for optimal cooling performance under GCC summer conditions:
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
        <table class="w-full text-start text-sm">
          <thead class="border-b border-border bg-secondary/50 text-xs font-bold text-foreground uppercase">
            <tr>
              <th scope="col" class="px-4 py-3.5 text-start">Vehicle & Model</th>
              <th scope="col" class="px-4 py-3.5 text-start">Years</th>
              <th scope="col" class="px-4 py-3.5 text-center">Refrigerant</th>
              <th scope="col" class="px-4 py-3.5 text-center">Single AC (g)</th>
              <th scope="col" class="px-4 py-3.5 text-center">Dual AC (g)</th>
              <th scope="col" class="px-4 py-3.5 text-start">Compressor Oil</th>
              <th scope="col" class="px-4 py-3.5 text-center">Guide</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border font-medium">
            {specs.map((spec) => (
              <tr class="hover:bg-secondary/30 transition-colors">
                <td class="px-4 py-3.5 font-bold text-foreground whitespace-nowrap">
                  {spec.brandNameEn} {spec.modelNameEn}
                  <span class="block text-xs font-normal text-muted-foreground">{spec.brandNameAr} {spec.modelNameAr}</span>
                </td>
                <td class="px-4 py-3.5 text-muted-foreground text-xs whitespace-nowrap">
                  {spec.defaultGeneration.years}
                </td>
                <td class="px-4 py-3.5 text-center">
                  <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-bold ${spec.defaultGeneration.refrigerantType === 'R1234yf' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400' : 'bg-primary/15 text-primary'}`}>
                    {spec.defaultGeneration.refrigerantType}
                  </span>
                </td>
                <td class="px-4 py-3.5 text-center font-mono font-bold text-foreground">
                  {spec.defaultGeneration.capacityGrams} g
                  <span class="block text-[11px] font-normal text-muted-foreground">± {spec.defaultGeneration.toleranceGrams}g</span>
                </td>
                <td class="px-4 py-3.5 text-center font-mono">
                  {spec.defaultGeneration.capacityGramsDualAc ? (
                    <span class="font-bold text-foreground">{spec.defaultGeneration.capacityGramsDualAc} g</span>
                  ) : (
                    <span class="text-xs text-muted-foreground">-</span>
                  )}
                </td>
                <td class="px-4 py-3.5 text-xs text-muted-foreground">
                  <span class="font-semibold text-foreground block">{spec.defaultGeneration.oilType}</span>
                  <span>{spec.defaultGeneration.oilCapacityMl} ml</span>
                </td>
                <td class="px-4 py-3.5 text-center whitespace-nowrap">
                  <a
                    href={`/en/tools/freon-capacity/${spec.brandSlug}/${spec.modelSlug}/`}
                    class="inline-flex items-center gap-1 rounded-lg border border-primary/30 px-2.5 py-1 text-xs font-semibold text-primary hover:bg-primary/10 transition"
                  >
                    <span>View</span>
                    <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Technical Guidance */}
  <section class="py-14 bg-secondary/20 border-t border-border">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div>
        <h2 class="text-2xl font-bold font-display text-foreground sm:text-3xl">
          Understanding Car AC Refrigerant In Extreme Temperatures
        </h2>
        <p class="mt-3 text-base text-muted-foreground leading-relaxed">
          In Riyadh summer conditions where ambient temperatures routinely surpass 45°C, precision refrigerant charging is critical to protect your compressor from excessive high-side pressure buildup.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-bold text-foreground text-lg flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-rose-500/10 text-rose-600 text-sm font-bold">1</span>
            Hazards of Overcharging
          </h3>
          <ul class="mt-3 space-y-2 text-xs text-muted-foreground leading-relaxed">
            <li>• High-side pressure spikes above 300 PSI, triggering emergency compressor cut-off.</li>
            <li>• Inadequate expansion space in the evaporator resulting in warm cabin air.</li>
            <li>• Severe parasitic engine drag increasing fuel consumption.</li>
            <li>• Risk of liquid slugging, destroying compressor internal valves.</li>
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-bold text-foreground text-lg flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 text-sm font-bold">2</span>
            Symptoms of Low Freon
          </h3>
          <ul class="mt-3 space-y-2 text-xs text-muted-foreground leading-relaxed">
            <li>• Diminished cooling performance, particularly in traffic congestion or at red lights.</li>
            <li>• Temperature disparity: cooler air on driver side, lukewarm air on passenger side.</li>
            <li>• Compressor oil starvation (oil circulates dissolved within refrigerant).</li>
            <li>• Evaporator core icing, blocking cabin air flow.</li>
          </ul>
        </div>
      </div>

      {/* Laser Leak Detection Feature */}
      <div class="rounded-2xl border border-primary/30 bg-card p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-2">
              Auto Save Laser Inspection
            </span>
            <h3 class="text-xl font-bold font-display text-foreground">
              Never refill Freon without laser leak testing!
            </h3>
            <p class="mt-2 text-sm text-muted-foreground max-w-2xl leading-relaxed">
              If your AC is low on freon, an active leak exists. We utilize ultrasonic and laser detection gear to locate microscopic leaks in condenser seams, O-rings, and evaporators without unnecessary dashboard removal.
            </p>
          </div>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hello Auto Save KSA, I would like to book a laser leak test and electronic scale recharge in Riyadh.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-xs font-bold text-primary-foreground transition hover:bg-primary/90 whitespace-nowrap shadow-sm"
          >
            <span>Book Laser Test</span>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
