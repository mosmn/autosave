---
import PageLayout from '../../../layouts/PageLayout.astro';
import FreonSchema from '../../../components/tools/FreonSchema.astro';

const lang = 'en' as const;
const site = Astro.site?.origin ?? 'https://autosaveks.com';

const title = 'Free Car AC & Auto Maintenance Calculators & Tools | Auto Save KSA';
const description =
  'Free interactive automotive tools for car owners and technicians in Saudi Arabia: Car AC Freon capacity lookup, compressor oil specs, and climate diagnostic tools.';
const keywords = [
  'car ac tools',
  'car freon capacity calculator',
  'refrigerant capacity chart saudi',
  'compressor oil spec lookup',
  'car ac diagnostic tool',
  'car repair riyadh',
];

const breadcrumbs = [
  { name: 'Home', url: `${site}/en/` },
  { name: 'Tools', url: `${site}/en/tools/` },
];

const tools = [
  {
    id: 'freon-capacity',
    title: 'Car AC Refrigerant & Compressor Oil Capacity Lookup',
    badge: 'Live - Free',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    description:
      'Instant specification lookup for refrigerant weight in grams, gas type (R134a vs R1234yf), compressor PAG oil viscosity, and summer PSI benchmarks for Saudi heat.',
    href: '/en/tools/freon-capacity/',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
    popularQueries: ['Camry freon capacity', 'Land Cruiser freon grams', 'Compressor oil spec', 'Car freon chart KSA'],
  },
  {
    id: 'ac-diagnostic',
    title: 'Interactive Car AC Diagnostic & Troubleshooting Wizard',
    badge: 'Live - Free',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    description:
      'Step-by-step smart troubleshooter identifying why your AC blows warm at idle, smells musty, or makes clicking noises, with estimated repair costs.',
    href: '/en/tools/ac-diagnostic/',
    iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    popularQueries: ['AC blows cold on highway only', 'AC blowing warm on one side', 'Car AC humming sound'],
  },
  {
    id: 'repair-cost',
    title: 'Car AC Repair Cost Estimator & Tabby/Tamara Calculator',
    badge: 'Live - Free',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    description:
      'Calculate estimated repair bills for compressor replacement, evaporator core repair, or freon recharge with 4-month zero-interest installment options.',
    href: '/en/tools/repair-cost-calculator/',
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    popularQueries: ['Compressor change price', 'Tabby car repair riyadh', 'Car ac inspection cost'],
  },
  {
    id: 'obd2-codes',
    title: 'OBD-II Climate Control & AC Trouble Code Lookup',
    badge: 'Live - Free',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    description:
      'Decode B-codes and P-codes related to AC pressure sensors and solar sensors. Learn whether the code represents a real sensor failure or normal shadow readings.',
    href: '/en/tools/obd2/',
    iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    popularQueries: ['Toyota B1421 code', 'AC sensor code P0532', 'HVAC fault codes'],
  },
  {
    id: 'fuel-cost',
    title: 'Car AC Fuel Consumption & Cost Calculator',
    badge: 'Live - Free',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    description:
      'Calculate monthly extra fuel expenses from running your car AC in Saudi heat, plus find out whether driving with open windows really saves petrol over AC.',
    href: '/en/tools/fuel-cost-calculator/',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
    popularQueries: ['How much fuel does AC use', 'AC vs open windows petrol', 'Car AC fuel cost KSA'],
  },
];
---

<PageLayout title={title} description={description} lang={lang} keywords={keywords}>
  <FreonSchema
    name={title}
    description={description}
    url={`${site}/en/tools/`}
    breadcrumbs={breadcrumbs}
    lang={lang}
  />

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/15 px-4 py-1.5 text-xs font-bold text-primary uppercase tracking-wide">
          Automotive Intelligence Hub
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight font-display text-foreground sm:text-5xl">
          Free Car AC & Auto Repair Tools
        </h1>
        <p class="mt-4 text-base text-muted-foreground sm:text-lg">
          At <strong class="text-foreground">Auto Save KSA</strong>, we developed free precision tools calibrated for GCC-specification vehicles and extreme Saudi summer heat (45°C+).
        </p>
      </div>

      {/* Tools Cards Grid */}
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
        {tools.map((tool) => (
          <div class="relative flex flex-col justify-between rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-sm transition hover:border-primary/40 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold ${tool.badgeColor}`}>
                  {tool.badge}
                </span>
                <div class="flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={tool.iconPath} />
                  </svg>
                </div>
              </div>

              <h2 class="mt-4 text-xl font-bold font-display text-foreground sm:text-2xl">
                <a href={tool.href} class="hover:text-primary transition-colors">
                  {tool.title}
                </a>
              </h2>

              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                {tool.description}
              </p>

              <div class="mt-5">
                <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Common Searches:</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {tool.popularQueries.map((query) => (
                    <span class="rounded-md bg-secondary/80 px-2 py-1 text-[11px] text-foreground font-medium">
                      {query}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-border flex items-center justify-between">
              <a
                href={tool.href}
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-primary-foreground shadow-sm transition hover:bg-primary/90"
              >
                <span>Launch Tool</span>
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <span class="text-xs font-medium text-muted-foreground">100% Free</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
